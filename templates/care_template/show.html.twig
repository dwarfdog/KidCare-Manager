{% extends 'base.html.twig' %}

{% block title %}{{ template.name }}{% endblock %}

{% block body %}
<div class="space-y-4">
    <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
        <div>
            <h1 class="text-2xl font-semibold">{{ template.name }}</h1>
            <p class="text-sm text-slate-500">{{ template.nanny.fullName }}</p>
        </div>
        <div class="flex flex-wrap gap-2">
            <a href="{{ path('app_care_template_edit', {'publicId': template.publicId}) }}" class="rounded-md bg-teal-600 px-4 py-2 text-sm font-semibold text-white">Modifier</a>
            <form method="post" action="{{ path('app_care_template_duplicate', {'publicId': template.publicId}) }}">
                <input type="hidden" name="_token" value="{{ csrf_token('duplicate_template_' ~ template.publicId) }}">
                <button class="rounded-md border border-slate-300 px-4 py-2 text-sm font-medium">Dupliquer</button>
            </form>
            <a href="{{ path('app_care_template_index') }}" class="rounded-md border border-slate-300 px-4 py-2 text-sm font-medium">Retour</a>
        </div>
    </div>

    <div class="grid grid-cols-1 gap-4 lg:grid-cols-2">
        {% for dayKey, dayLabel in days %}
            {% set dayConfig = template.weekSchedule[dayKey] %}
            <section class="rounded-lg border border-slate-200 bg-white p-5">
                <div class="flex items-center justify-between">
                    <h2 class="font-semibold">{{ dayLabel }}</h2>
                    <span class="rounded-full px-2.5 py-1 text-xs font-semibold ring-1 ring-inset {{ dayConfig.isActive ? 'bg-teal-50 text-teal-700 ring-teal-600/20' : 'bg-slate-50 text-slate-600 ring-slate-500/20' }}">{{ dayConfig.isActive ? 'Actif' : 'Inactif' }}</span>
                </div>
                <div class="mt-4 space-y-2">
                    {% if dayConfig.isActive and dayConfig.slots|length > 0 %}
                        {% for slot in dayConfig.slots %}
                            <div class="flex items-center justify-between gap-3 rounded-md border border-slate-100 bg-slate-50 px-3 py-2 text-sm">
                                <span class="font-medium tabular-nums">{{ slot.startTime }} - {{ slot.endTime }}</span>
                                <span class="rounded-full bg-white px-2 py-0.5 text-xs font-semibold text-slate-600 ring-1 ring-inset ring-slate-200">{{ slot.mealsCount }} repas</span>
                            </div>
                        {% endfor %}
                    {% else %}
                        <p class="text-sm text-slate-500">Aucun creneau.</p>
                    {% endif %}
                </div>
            </section>
        {% endfor %}
    </div>
</div>
{% endblock %}
