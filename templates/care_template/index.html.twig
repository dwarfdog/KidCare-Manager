{% extends 'base.html.twig' %}
{% import 'components/_icon_action.html.twig' as icons %}

{% block title %}Templates{% endblock %}

{% block body %}
<div class="space-y-6">
    <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
        <div>
            <h1 class="text-2xl font-semibold">Templates de garde</h1>
            <p class="text-sm text-slate-500">Planning type applicable a une semaine.</p>
        </div>
        <a href="{{ path('app_care_template_new') }}" class="inline-flex items-center justify-center rounded-md bg-teal-600 px-4 py-2 text-sm font-semibold text-white hover:bg-teal-700">
            <i class="fa-solid fa-plus mr-2"></i>Nouveau template
        </a>
    </div>

    <div class="grid grid-cols-1 gap-4 md:grid-cols-2 xl:grid-cols-3">
        {% for template in templates %}
            <article class="rounded-lg border border-slate-200 bg-white p-5">
                <div class="flex items-start justify-between gap-3">
                    <div class="min-w-0">
                        <h2 class="font-semibold">{{ template.name }}</h2>
                        <p class="text-sm text-slate-500">{{ template.nanny.fullName }}</p>
                    </div>
                    <div class="flex items-center gap-1">
                        {{ icons.link('eye', 'Voir le template ' ~ template.name, path('app_care_template_show', {'publicId': template.publicId}), 'primary') }}
                        {{ icons.link('pen', 'Modifier le template ' ~ template.name, path('app_care_template_edit', {'publicId': template.publicId})) }}
                    </div>
                </div>

                {% set activeDays = template.weekSchedule|filter(config => config.isActive)|length %}
                <div class="mt-4 flex flex-wrap gap-2">
                    {% for day, config in template.weekSchedule %}
                        {% if config.isActive %}
                            <span class="rounded-full bg-teal-50 px-2.5 py-1 text-xs font-semibold text-teal-700 ring-1 ring-inset ring-teal-600/20">{{ days[day] }}</span>
                        {% endif %}
                    {% endfor %}
                    {% if activeDays == 0 %}
                        <span class="rounded-full bg-amber-50 px-2.5 py-1 text-xs font-semibold text-amber-700 ring-1 ring-inset ring-amber-600/20">Aucun jour actif</span>
                    {% endif %}
                </div>

                <div class="mt-5 flex items-center gap-1">
                    <form method="post" action="{{ path('app_care_template_duplicate', {'publicId': template.publicId}) }}">
                        <input type="hidden" name="_token" value="{{ csrf_token('duplicate_template_' ~ template.publicId) }}">
                        {{ icons.button('copy', 'Dupliquer le template ' ~ template.name) }}
                    </form>
                    <form
                        method="post"
                        action="{{ path('app_care_template_delete', {'publicId': template.publicId}) }}"
                        data-controller="confirm"
                        data-action="submit->confirm#submit"
                        data-confirm-title-value="Supprimer ce template ?"
                        data-confirm-text-value="Cette action supprime uniquement le modele, pas les gardes deja creees."
                        data-confirm-confirm-text-value="Supprimer"
                    >
                        <input type="hidden" name="_token" value="{{ csrf_token('delete_template_' ~ template.publicId) }}">
                        {{ icons.button('trash-can', 'Supprimer le template ' ~ template.name, 'danger') }}
                    </form>
                </div>
            </article>
        {% else %}
            <div class="rounded-lg border border-dashed border-slate-300 bg-white p-8 text-center text-sm text-slate-500 md:col-span-2 xl:col-span-3">
                <i class="fa-regular fa-calendar-plus mb-2 text-xl text-slate-300"></i>
                <p>Aucun template.</p>
            </div>
        {% endfor %}
    </div>
</div>
{% endblock %}
