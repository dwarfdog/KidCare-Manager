{# Bibliotheque de boutons/liens icone + tooltip Tippy, pour les actions repetees en liste
   (Modifier, Archiver, Supprimer, Voir...). Usage:
   {% import 'components/_icon_action.html.twig' as icons %}
   {{ icons.link('pen', 'Modifier le compte Boursorama', path('...')) }}
   {{ icons.button('trash-can', 'Supprimer la ligne 2', 'danger') }}
#}
{% macro link(icon, tooltip, href, variant, attr) %}
    {%- import _self as self -%}
    <a href="{{ href }}" aria-label="{{ tooltip }}" data-tippy-content="{{ tooltip }}" class="{{ self.classes(variant, attr) }}"{{ self.extra_attrs(attr) }}>
        <i class="fa-solid fa-{{ icon }}"></i>
    </a>
{% endmacro %}

{% macro button(icon, tooltip, variant, attr) %}
    {%- import _self as self -%}
    <button type="{{ (attr|default({})).type|default('submit') }}" aria-label="{{ tooltip }}" data-tippy-content="{{ tooltip }}" class="{{ self.classes(variant, attr) }}"{{ self.extra_attrs(attr) }}>
        <i class="fa-solid fa-{{ icon }}"></i>
    </button>
{% endmacro %}

{% macro classes(variant, attr) %}
    {%- set variants = {
        default: 'text-slate-500 hover:bg-slate-100 hover:text-slate-900',
        primary: 'text-teal-600 hover:bg-teal-50 hover:text-teal-800',
        danger: 'text-rose-600 hover:bg-rose-50 hover:text-rose-800',
    } -%}
    inline-flex h-8 w-8 shrink-0 items-center justify-center rounded-md transition-colors {{ variants[variant|default('default')]|default(variants.default) }} {{ (attr|default({})).class|default('') }}
{% endmacro %}

{% macro extra_attrs(attr) %}
    {%- for name, value in attr|default({}) -%}
        {%- if name not in ['class', 'type'] %} {{ name }}="{{ value }}"{% endif -%}
    {%- endfor -%}
{% endmacro %}
