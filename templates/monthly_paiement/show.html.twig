{% extends 'base.html.twig' %}

{% block title %}Paiement {{ payment.month }}{% endblock %}

{% block body %}
<div class="space-y-6">
    <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
        <div>
            <h1 class="text-2xl font-semibold">Paiement {{ payment.month }}</h1>
            <p class="text-sm text-slate-500">{{ payment.nannyDisplayName }}</p>
        </div>
        <div class="flex flex-wrap gap-2">
            {% if payment.isPaid %}
                <a href="{{ path('app_monthly_payment_export_csv', {'publicId': payment.publicId}) }}" class="rounded-md border border-slate-300 px-4 py-2 text-sm font-medium hover:bg-slate-50">
                    <i class="fa-solid fa-file-csv mr-2"></i>CSV
                </a>
                <a href="{{ path('app_monthly_payment_export_pdf', {'publicId': payment.publicId}) }}" class="rounded-md border border-slate-300 px-4 py-2 text-sm font-medium hover:bg-slate-50">
                    <i class="fa-solid fa-file-pdf mr-2"></i>PDF
                </a>
            {% endif %}
            <a href="{{ path('app_home') }}" class="rounded-md border border-slate-300 px-4 py-2 text-sm font-medium hover:bg-slate-50">Retour</a>
        </div>
    </div>

    <div class="grid grid-cols-1 gap-4 md:grid-cols-4">
        <div class="rounded-lg border border-slate-200 bg-white p-5">
            <p class="text-sm text-slate-500">Heures</p>
            <p class="mt-2 text-2xl font-semibold tabular-nums">{{ payment.totalsHours|number_format(2, ',', ' ') }}</p>
        </div>
        <div class="rounded-lg border border-slate-200 bg-white p-5">
            <p class="text-sm text-slate-500">Repas</p>
            <p class="mt-2 text-2xl font-semibold tabular-nums">{{ payment.totalMeals }}</p>
        </div>
        <div class="rounded-lg border border-slate-200 bg-white p-5">
            <p class="text-sm text-slate-500">Total</p>
            <p class="mt-2 text-2xl font-semibold tabular-nums">{{ payment.totalAmount|number_format(2, ',', ' ') }} {{ currency }}</p>
        </div>
        <div class="rounded-lg border border-slate-200 bg-white p-5">
            <p class="text-sm text-slate-500">Statut</p>
            <div class="mt-3">{% include '_payment_status_badge.html.twig' with {payment: payment} only %}</div>
        </div>
    </div>

    <div class="rounded-lg border border-slate-200 bg-white">
        <div class="border-b border-slate-200 px-5 py-4">
            <h2 class="font-semibold">Gardes du mois</h2>
        </div>
        <div class="overflow-x-auto">
            <table class="min-w-full divide-y divide-slate-200">
                <thead class="bg-slate-50">
                    <tr>
                        <th class="px-5 py-3 text-left text-xs font-semibold uppercase text-slate-500">Date</th>
                        <th class="px-5 py-3 text-left text-xs font-semibold uppercase text-slate-500">Horaires</th>
                        <th class="px-5 py-3 text-left text-xs font-semibold uppercase text-slate-500">Duree</th>
                        <th class="px-5 py-3 text-left text-xs font-semibold uppercase text-slate-500">Repas</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100 bg-white">
                    {% for care in cares %}
                        <tr class="hover:bg-slate-50">
                            <td class="px-5 py-3 text-sm">{{ care.date|date('d/m/Y') }}</td>
                            <td class="whitespace-nowrap px-5 py-3 text-sm">{{ care.startTime|date('H:i') }} - {{ care.endTime|date('H:i') }}</td>
                            <td class="whitespace-nowrap px-5 py-3 text-sm tabular-nums">{{ care.hoursCount|number_format(2, ',', ' ') }} h</td>
                            <td class="px-5 py-3 text-sm tabular-nums">{{ care.mealsCount }}</td>
                        </tr>
                    {% else %}
                        <tr><td colspan="4" class="px-5 py-6 text-center text-sm text-slate-500">Aucune garde.</td></tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>

    <div class="flex justify-end">
        {% if not payment.isPaid %}
            <form
                method="post"
                action="{{ path('app_monthly_payment_mark_as_paid', {'publicId': payment.publicId}) }}"
                data-controller="confirm"
                data-action="submit->confirm#submit"
                data-confirm-title-value="Marquer ce mois comme payé ?"
                data-confirm-text-value="Les gardes de ce mois seront gelées après recalcul."
                data-confirm-confirm-text-value="Marquer payé"
            >
                <input type="hidden" name="_token" value="{{ csrf_token('payment_paid_' ~ payment.publicId) }}">
                <button class="rounded-md bg-teal-600 px-4 py-2 text-sm font-semibold text-white">Marquer paye</button>
            </form>
        {% else %}
            <form
                method="post"
                action="{{ path('app_monthly_payment_mark_as_unpaid', {'publicId': payment.publicId}) }}"
                data-controller="confirm"
                data-action="submit->confirm#submit"
                data-confirm-title-value="Remettre ce mois en impayé ?"
                data-confirm-text-value="Les montants seront recalculés avec les tarifs historiques applicables."
                data-confirm-confirm-text-value="Remettre impayé"
            >
                <input type="hidden" name="_token" value="{{ csrf_token('payment_unpaid_' ~ payment.publicId) }}">
                <button class="rounded-md border border-red-200 px-4 py-2 text-sm font-semibold text-red-700">Remettre impaye</button>
            </form>
        {% endif %}
    </div>
</div>
{% endblock %}
