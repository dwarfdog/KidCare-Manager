{% extends 'base.html.twig' %}

{% block title %}Inscription{% endblock %}

{% block body %}
<div class="mx-auto flex min-h-[calc(100vh-14rem)] max-w-md items-center px-4 py-10">
    <div class="w-full rounded-lg border border-slate-200 bg-white p-6 shadow-sm">
        <div>
            <h1 class="text-2xl font-semibold text-slate-950">Créer un compte</h1>
            <p class="mt-2 text-sm text-slate-500">L'identifiant reste le moyen de connexion principal.</p>
        </div>

        {{ form_start(registrationForm, {'attr': {'class': 'mt-6 space-y-5'}}) }}
            {{ form_errors(registrationForm) }}

            <div>
                {{ form_label(registrationForm.username, 'Identifiant', {'label_attr': {'class': 'text-sm font-medium text-slate-700'}}) }}
                {{ form_widget(registrationForm.username, {'attr': {'class': 'mt-2 w-full rounded-md border border-slate-300 px-3 py-2 text-sm shadow-sm focus:border-sky-500 focus:outline-none focus:ring-2 focus:ring-sky-100', 'autocomplete': 'username'}}) }}
                {{ form_errors(registrationForm.username) }}
            </div>

            <div>
                {{ form_label(registrationForm.email, 'Email', {'label_attr': {'class': 'text-sm font-medium text-slate-700'}}) }}
                {{ form_widget(registrationForm.email, {'attr': {'class': 'mt-2 w-full rounded-md border border-slate-300 px-3 py-2 text-sm shadow-sm focus:border-sky-500 focus:outline-none focus:ring-2 focus:ring-sky-100', 'autocomplete': 'email'}}) }}
                {{ form_errors(registrationForm.email) }}
            </div>

            <div>
                {{ form_label(registrationForm.plainPassword, 'Mot de passe', {'label_attr': {'class': 'text-sm font-medium text-slate-700'}}) }}
                {{ form_widget(registrationForm.plainPassword, {'attr': {'class': 'mt-2 w-full rounded-md border border-slate-300 px-3 py-2 text-sm shadow-sm focus:border-sky-500 focus:outline-none focus:ring-2 focus:ring-sky-100', 'autocomplete': 'new-password'}}) }}
                {{ form_errors(registrationForm.plainPassword) }}
            </div>

            <div class="flex items-start gap-3">
                {{ form_widget(registrationForm.agreeTerms, {'attr': {'class': 'mt-1 h-4 w-4 rounded border-slate-300 text-sky-600 focus:ring-sky-500'}}) }}
                <div>
                    {{ form_label(registrationForm.agreeTerms, "J'accepte les conditions d'utilisation", {'label_attr': {'class': 'text-sm text-slate-700'}}) }}
                    {{ form_errors(registrationForm.agreeTerms) }}
                </div>
            </div>

            <button type="submit" class="inline-flex w-full items-center justify-center rounded-md bg-sky-600 px-4 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-sky-700 focus:outline-none focus:ring-2 focus:ring-sky-500 focus:ring-offset-2">
                S'inscrire
            </button>
        {{ form_end(registrationForm) }}

        <p class="mt-5 text-center text-sm text-slate-500">
            Déjà un compte ?
            <a href="{{ path('app_login') }}" class="font-medium text-sky-700 hover:text-sky-800">Se connecter</a>
        </p>
    </div>
</div>
{% endblock %}
