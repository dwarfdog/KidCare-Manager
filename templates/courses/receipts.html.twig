{% extends 'base.html.twig' %}
{% import 'components/_icon_action.html.twig' as icons %}

{% block title %}Tickets{% endblock %}

{% block body %}
{% include 'courses/_tabs.html.twig' %}

<div class="space-y-5">
    <div class="rounded-lg border border-slate-200 bg-white">
        <div class="border-b border-slate-200 px-5 py-4"><h1 class="text-lg font-semibold">A relire</h1></div>
        <div class="divide-y divide-slate-100">
            {% for receipt in pending %}
                <div class="flex flex-wrap items-center justify-between gap-3 px-5 py-3 text-sm">
                    <div>
                        <span class="font-medium">{{ receipt.purchaseDate ? receipt.purchaseDate|date('d/m/Y') : 'Date inconnue' }}</span>
                        <span class="ml-2 text-slate-400">{{ receipt.sourceFormat }}</span>
                        {% if receipt.status == 'failed' %}<span class="ml-2 rounded-full bg-rose-100 px-2 py-0.5 text-xs font-semibold text-rose-700">Echec analyse</span>{% endif %}
                    </div>
                    <div class="flex items-center gap-2">
                        <span class="font-semibold tabular-nums">{{ receipt.totalAmount|number_format(2, ',', ' ') }} €</span>
                        {{ icons.link('magnifying-glass', 'Relire ce ticket', path('app_courses_receipt_review', {publicId: receipt.publicId}), 'primary') }}
                        <form method="post" action="{{ path('app_courses_receipt_archive', {publicId: receipt.publicId}) }}" data-controller="confirm" data-confirm-title-value="Archiver ce ticket ?" data-confirm-text-value="Il restera consultable dans les Archives." data-confirm-confirm-text-value="Archiver" data-action="confirm#submit">
                            <input type="hidden" name="_token" value="{{ csrf_token('courses_receipt_archive_' ~ receipt.publicId) }}">
                            {{ icons.button('box-archive', 'Archiver ce ticket', 'danger') }}
                        </form>
                    </div>
                </div>
            {% else %}
                <p class="px-5 py-8 text-center text-sm text-slate-500">Aucun ticket en attente de relecture.</p>
            {% endfor %}
        </div>
    </div>

    <div class="rounded-lg border border-slate-200 bg-white">
        <div class="border-b border-slate-200 px-5 py-4"><h2 class="text-lg font-semibold">Historique</h2></div>
        <div class="divide-y divide-slate-100">
            {% for receipt in confirmed %}
                <a href="{{ path('app_courses_receipt_show', {publicId: receipt.publicId}) }}" class="flex flex-wrap items-center justify-between gap-3 px-5 py-3 text-sm hover:bg-slate-50">
                    <div>
                        <span class="font-medium">{{ receipt.purchaseDate|date('d/m/Y') }}</span>
                        {% if receipt.store %}<span class="ml-2 text-slate-400">{{ storeManager.name(receipt.store) }}</span>{% endif %}
                    </div>
                    <span class="font-semibold tabular-nums">{{ receipt.totalAmount|number_format(2, ',', ' ') }} €</span>
                </a>
            {% else %}
                <p class="px-5 py-8 text-center text-sm text-slate-500">Aucun ticket confirme.</p>
            {% endfor %}
        </div>
    </div>
</div>
{% endblock %}
