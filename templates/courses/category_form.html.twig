{% extends 'base.html.twig' %}

{% block title %}{{ title }}{% endblock %}

{% block body %}
{% include 'courses/_tabs.html.twig' %}
<div class="mx-auto max-w-xl">
    <div class="rounded-lg border border-slate-200 bg-white p-6 shadow-sm">
        <h1 class="mb-6 text-lg font-semibold">{{ title }}</h1>
        {{ form_start(form) }}
            {{ form_widget(form) }}
            <div class="mt-4 flex flex-wrap gap-3">
                <button class="rounded-md bg-teal-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-teal-700">Enregistrer</button>
                <a href="{{ path('app_courses_categories') }}" class="rounded-md border border-slate-300 px-4 py-2 text-sm font-semibold text-slate-700 hover:bg-slate-50">Annuler</a>
            </div>
        {{ form_end(form) }}
    </div>
</div>
{% endblock %}
