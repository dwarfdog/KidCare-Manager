{% extends 'base.html.twig' %}
{% import 'components/_icon_action.html.twig' as icons %}

{% block title %}Produits{% endblock %}

{% block body %}
{% include 'courses/_tabs.html.twig' %}
<div class="rounded-lg border border-slate-200 bg-white">
    <div class="flex flex-wrap items-center justify-between gap-3 border-b border-slate-200 px-5 py-4">
        <h1 class="text-lg font-semibold">Produits</h1>
        <a href="{{ path('app_courses_product_new') }}" class="rounded-md bg-teal-600 px-3 py-2 text-sm font-semibold text-white shadow-sm hover:bg-teal-700"><i class="fa-solid fa-plus"></i> Nouveau produit</a>
    </div>
    <div class="overflow-x-auto">
        <table class="min-w-full divide-y divide-slate-200">
            <thead class="bg-slate-50">
                <tr>
                    <th class="px-5 py-3 text-left text-xs font-semibold uppercase text-slate-500">Produit</th>
                    <th class="px-5 py-3 text-left text-xs font-semibold uppercase text-slate-500">Categorie</th>
                    <th class="px-5 py-3 text-left text-xs font-semibold uppercase text-slate-500">Unite</th>
                    <th class="px-5 py-3 text-right text-xs font-semibold uppercase text-slate-500">Actions</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-slate-100">
                {% for product in products %}
                    <tr class="hover:bg-slate-50">
                        <td class="px-5 py-3 text-sm font-medium">{{ productManager.name(product) }}</td>
                        <td class="px-5 py-3 text-sm text-slate-500">{{ product.category ? product.category.name : '—' }}</td>
                        <td class="px-5 py-3 text-sm text-slate-500">{{ product.defaultUnit }}</td>
                        <td class="px-5 py-3 text-right text-sm">
                            <span class="inline-flex items-center gap-1">
                                {{ icons.link('chart-line', 'Voir les prix de ' ~ productManager.name(product), path('app_courses_analytics', {product: product.publicId}), 'primary') }}
                                {{ icons.link('pen', 'Modifier ' ~ productManager.name(product), path('app_courses_product_edit', {publicId: product.publicId})) }}
                                <form method="post" action="{{ path('app_courses_product_archive', {publicId: product.publicId}) }}" data-controller="confirm" data-confirm-title-value="Archiver ce produit ?" data-confirm-text-value="Il restera consultable dans les Archives." data-confirm-confirm-text-value="Archiver" data-action="confirm#submit">
                                    <input type="hidden" name="_token" value="{{ csrf_token('courses_product_archive_' ~ product.publicId) }}">
                                    {{ icons.button('box-archive', 'Archiver ' ~ productManager.name(product), 'danger') }}
                                </form>
                            </span>
                        </td>
                    </tr>
                {% else %}
                    <tr><td colspan="4" class="px-5 py-8 text-center text-sm text-slate-500">Aucun produit.</td></tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>
{% endblock %}
