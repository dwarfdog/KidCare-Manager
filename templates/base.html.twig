<!DOCTYPE html>
<html lang="fr">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>{% block title %}{% endblock %} - KidCare & Bank Manager</title>
        <meta name="description" content="{% block meta_description %}Gestion des heures de garde, contrats, paiements et finances du foyer{% endblock %}">
        <link rel="icon" href="{{ asset('favicon.png') }}">
        {% block stylesheets %}{{ encore_entry_link_tags('app') }}{% endblock %}
        {% block javascripts_head %}{{ encore_entry_script_tags('app') }}{% endblock %}
    </head>
    <body class="min-h-screen bg-slate-50 text-slate-900" {{ stimulus_controller('tippy') }}>
        {% set current_route = app.request.attributes.get('_route')|default('') %}
        <header class="border-b border-slate-200 bg-white">
            <nav class="mx-auto flex h-16 max-w-7xl items-center justify-between px-4 sm:px-6 lg:px-8">
                <a href="{{ path('app_home') }}" class="text-lg font-semibold text-slate-950">KidCare & Bank</a>

                {% if app.user %}
                    <div class="hidden items-center gap-1 md:flex">
                        <a href="{{ path('app_home') }}" class="rounded-md px-3 py-2 text-sm font-medium {{ current_route == 'app_home' or current_route starts with 'app_monthly_payment_' ? 'bg-slate-100 text-slate-950' : 'text-slate-700 hover:bg-slate-100' }}">Accueil</a>
                        <a href="{{ path('app_care_index') }}" class="rounded-md px-3 py-2 text-sm font-medium {{ current_route starts with 'app_care_' and not (current_route starts with 'app_care_template_') ? 'bg-slate-100 text-slate-950' : 'text-slate-700 hover:bg-slate-100' }}">Planning</a>
                        <a href="{{ path('app_nanny_index') }}" class="rounded-md px-3 py-2 text-sm font-medium {{ current_route starts with 'app_nanny_' ? 'bg-slate-100 text-slate-950' : 'text-slate-700 hover:bg-slate-100' }}">Nounous</a>
                        <a href="{{ path('app_care_template_index') }}" class="rounded-md px-3 py-2 text-sm font-medium {{ current_route starts with 'app_care_template_' ? 'bg-slate-100 text-slate-950' : 'text-slate-700 hover:bg-slate-100' }}">Templates</a>
                        <a href="{{ path('app_bank_index') }}" class="rounded-md px-3 py-2 text-sm font-medium {{ current_route starts with 'app_bank_' ? 'bg-slate-100 text-slate-950' : 'text-slate-700 hover:bg-slate-100' }}">Banque</a>
                        <a href="{{ path('app_account_profile') }}" class="rounded-md px-3 py-2 text-sm font-medium {{ current_route starts with 'app_account_' ? 'bg-slate-100 text-slate-950' : 'text-slate-700 hover:bg-slate-100' }}">Compte</a>
                    </div>
                {% endif %}

                <div class="hidden items-center gap-4 md:flex">
                    {% if app.user %}
                        <span class="text-sm text-slate-500">{{ app.user.username }}</span>
                        <a href="{{ path('app_logout') }}" class="text-sm font-medium text-slate-700 hover:text-slate-950">Deconnexion</a>
                    {% else %}
                        <a href="{{ path('app_login') }}" class="text-sm font-medium text-slate-700 hover:text-slate-950">Connexion</a>
                        <a href="{{ path('app_register') }}" class="rounded-md bg-teal-600 px-3 py-2 text-sm font-semibold text-white hover:bg-teal-700">Inscription</a>
                    {% endif %}
                </div>

                <div x-data="{ open: false }" class="md:hidden">
                    <button type="button" @click="open = !open" class="inline-flex h-10 w-10 items-center justify-center rounded-md text-slate-700 hover:bg-slate-100">
                        <i class="fa-solid fa-bars"></i>
                    </button>
                    <div x-show="open" x-cloak @click.away="open = false" class="absolute right-4 top-14 z-50 w-56 rounded-md border border-slate-200 bg-white py-2 shadow-lg">
                        {% if app.user %}
                            <a href="{{ path('app_home') }}" class="block px-4 py-2 text-sm {{ current_route == 'app_home' or current_route starts with 'app_monthly_payment_' ? 'bg-slate-100 font-medium text-slate-950' : 'text-slate-700 hover:bg-slate-100' }}">Accueil</a>
                            <a href="{{ path('app_care_index') }}" class="block px-4 py-2 text-sm {{ current_route starts with 'app_care_' and not (current_route starts with 'app_care_template_') ? 'bg-slate-100 font-medium text-slate-950' : 'text-slate-700 hover:bg-slate-100' }}">Planning</a>
                            <a href="{{ path('app_nanny_index') }}" class="block px-4 py-2 text-sm {{ current_route starts with 'app_nanny_' ? 'bg-slate-100 font-medium text-slate-950' : 'text-slate-700 hover:bg-slate-100' }}">Nounous</a>
                            <a href="{{ path('app_care_template_index') }}" class="block px-4 py-2 text-sm {{ current_route starts with 'app_care_template_' ? 'bg-slate-100 font-medium text-slate-950' : 'text-slate-700 hover:bg-slate-100' }}">Templates</a>
                            <a href="{{ path('app_bank_index') }}" class="block px-4 py-2 text-sm {{ current_route starts with 'app_bank_' ? 'bg-slate-100 font-medium text-slate-950' : 'text-slate-700 hover:bg-slate-100' }}">Banque</a>
                            <a href="{{ path('app_account_profile') }}" class="block px-4 py-2 text-sm {{ current_route starts with 'app_account_' ? 'bg-slate-100 font-medium text-slate-950' : 'text-slate-700 hover:bg-slate-100' }}">Compte</a>
                            <a href="{{ path('app_logout') }}" class="block px-4 py-2 text-sm text-slate-700 hover:bg-slate-100">Deconnexion</a>
                        {% else %}
                            <a href="{{ path('app_login') }}" class="block px-4 py-2 text-sm text-slate-700 hover:bg-slate-100">Connexion</a>
                            <a href="{{ path('app_register') }}" class="block px-4 py-2 text-sm text-slate-700 hover:bg-slate-100">Inscription</a>
                        {% endif %}
                    </div>
                </div>
            </nav>
        </header>

        <div id="flash-messages" data-flashes='{{ app.flashes|json_encode }}' {{ stimulus_controller('notyf') }}></div>

        <main class="mx-auto flex w-full max-w-7xl flex-col gap-4 px-4 py-4 sm:px-6 lg:flex-row lg:px-8">
            {% block sidebar %}{% endblock %}
            <section class="{% if show_sidebar is defined and show_sidebar %}min-w-0 flex-1{% else %}w-full{% endif %}">
                {% block body %}{% endblock %}
            </section>
        </main>

        <footer class="mt-8 border-t border-slate-200 bg-white">
            <div class="mx-auto flex max-w-7xl flex-col gap-3 px-4 py-4 text-sm text-slate-500 sm:px-6 md:flex-row md:items-center md:justify-between lg:px-8">
                <p>&copy; {{ "now"|date("Y") }} KidCare & Bank Manager.</p>
                <div class="flex flex-wrap gap-4">
                    <a href="{{ path('app_privacy_policy') }}" class="hover:text-slate-900">Confidentialite</a>
                    <a href="{{ path('app_terms_of_service') }}" class="hover:text-slate-900">Conditions</a>
                </div>
            </div>
        </footer>

        {% block javascripts %}{% endblock %}
    </body>
</html>
