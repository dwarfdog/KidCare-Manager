{% extends 'base.html.twig' %}

{% block title %}Tableau de bord{% endblock %}

{% block body %}
<div class="space-y-6">
    <div class="grid grid-cols-1 gap-4 md:grid-cols-3">
        <div class="rounded-lg border border-slate-200 bg-white p-5">
            <p class="text-sm font-medium text-slate-500">Nounous rattachees</p>
            <p class="mt-2 text-3xl font-semibold">{{ nannies|length }}</p>
        </div>
        <div class="rounded-lg border border-slate-200 bg-white p-5">
            <p class="text-sm font-medium text-slate-500">Mois courant</p>
            <p class="mt-2 text-3xl font-semibold">{{ currentPayments|length }}</p>
        </div>
        <div class="rounded-lg border border-slate-200 bg-white p-5">
            <p class="text-sm font-medium text-slate-500">Prochaine garde</p>
            {% if nextCare %}
                <p class="mt-2 text-base font-semibold">{{ nextCare.nannyDisplayName }}</p>
                <p class="text-sm text-slate-500">{{ nextCare.date|date('d/m/Y') }} {{ nextCare.startTime|date('H:i') }}</p>
            {% else %}
                <p class="mt-2 text-base text-slate-500">Aucune garde prevue</p>
            {% endif %}
        </div>
    </div>

    <div class="rounded-lg border border-slate-200 bg-white">
        <div class="flex items-center justify-between gap-3 border-b border-slate-200 px-5 py-4">
            <h1 class="text-lg font-semibold">Paiements du mois</h1>
            <span class="rounded-full bg-slate-100 px-2.5 py-1 text-xs font-semibold text-slate-600">{{ currentPayments|length }}</span>
        </div>
        <div class="overflow-x-auto">
            <table class="min-w-full divide-y divide-slate-200">
                <thead class="bg-slate-50">
                    <tr>
                        <th class="px-5 py-3 text-left text-xs font-semibold uppercase text-slate-500">Nounou</th>
                        <th class="px-5 py-3 text-left text-xs font-semibold uppercase text-slate-500">Heures</th>
                        <th class="px-5 py-3 text-left text-xs font-semibold uppercase text-slate-500">Montant</th>
                        <th class="px-5 py-3 text-left text-xs font-semibold uppercase text-slate-500">Statut</th>
                        <th class="px-5 py-3 text-right text-xs font-semibold uppercase text-slate-500">Action</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100 bg-white">
                    {% for payment in currentPayments %}
                        <tr class="hover:bg-slate-50">
                            <td class="px-5 py-3 text-sm font-medium">{{ payment.nannyDisplayName }}</td>
                            <td class="whitespace-nowrap px-5 py-3 text-sm tabular-nums">{{ payment.totalsHours|number_format(2, ',', ' ') }} h</td>
                            <td class="whitespace-nowrap px-5 py-3 text-sm font-medium tabular-nums">{{ payment.totalAmount|number_format(2, ',', ' ') }} {{ currency }}</td>
                            <td class="px-5 py-3 text-sm">{% include '_payment_status_badge.html.twig' with {payment: payment} only %}</td>
                            <td class="px-5 py-3 text-right text-sm">
                                <a href="{{ path('app_monthly_payment_show', {'publicId': payment.publicId}) }}" class="font-medium text-teal-700 hover:text-teal-900">Voir</a>
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="5" class="px-5 py-8 text-center">
                                <div class="mx-auto max-w-sm text-sm text-slate-500">
                                    <i class="fa-regular fa-calendar-check mb-2 text-xl text-slate-300"></i>
                                    <p>Aucun paiement pour le mois courant.</p>
                                </div>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>

    <div class="rounded-lg border border-slate-200 bg-white">
        <div class="flex items-center justify-between gap-3 border-b border-slate-200 px-5 py-4">
            <h2 class="text-lg font-semibold">Historique</h2>
            <span class="rounded-full bg-slate-100 px-2.5 py-1 text-xs font-semibold text-slate-600">{{ previousPayments|length }}</span>
        </div>
        <div class="overflow-x-auto">
            <table class="min-w-full divide-y divide-slate-200">
                <tbody class="divide-y divide-slate-100 bg-white">
                    {% for payment in previousPayments %}
                        <tr class="hover:bg-slate-50">
                            <td class="px-5 py-3 text-sm font-medium">{{ payment.month }}</td>
                            <td class="px-5 py-3 text-sm">{{ payment.nannyDisplayName }}</td>
                            <td class="whitespace-nowrap px-5 py-3 text-sm font-medium tabular-nums">{{ payment.totalAmount|number_format(2, ',', ' ') }} {{ currency }}</td>
                            <td class="px-5 py-3 text-sm">{% include '_payment_status_badge.html.twig' with {payment: payment} only %}</td>
                            <td class="px-5 py-3 text-right text-sm">
                                <a href="{{ path('app_monthly_payment_show', {'publicId': payment.publicId}) }}" class="font-medium text-teal-700 hover:text-teal-900">Voir</a>
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td class="px-5 py-8 text-center text-sm text-slate-500">Aucun historique.</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
</div>
{% endblock %}
