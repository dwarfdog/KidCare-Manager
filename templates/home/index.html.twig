{% extends 'base.html.twig' %}

{% block title %}Accueil{% endblock %}

{% block body %}
<section class="grid min-h-[calc(100vh-14rem)] items-center gap-8 py-10 lg:grid-cols-[1fr_28rem]">
    <div>
        <p class="text-sm font-semibold uppercase tracking-wide text-sky-700">KidCare Manager</p>
        <h1 class="mt-3 max-w-3xl text-4xl font-semibold text-slate-950 sm:text-5xl">
            Planning, contrats privés et paiements de garde au même endroit.
        </h1>
        <p class="mt-5 max-w-2xl text-base leading-7 text-slate-600">
            Suivez les gardes, appliquez des semaines types, rattachez une nounou existante et gardez des totaux mensuels recalculés avec les tarifs historiques.
        </p>
        <div class="mt-7 flex flex-col gap-3 sm:flex-row">
            <a href="{{ path('app_register') }}" class="inline-flex items-center justify-center rounded-md bg-sky-600 px-5 py-3 text-sm font-semibold text-white shadow-sm hover:bg-sky-700">
                Créer un compte
            </a>
            <a href="{{ path('app_login') }}" class="inline-flex items-center justify-center rounded-md border border-slate-300 px-5 py-3 text-sm font-semibold text-slate-700 hover:bg-white">
                Se connecter
            </a>
        </div>
    </div>

    <div class="rounded-lg border border-slate-200 bg-white p-5 shadow-sm">
        <div class="space-y-4">
            <div class="flex items-start gap-3">
                <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-md bg-sky-100 text-sky-700">
                    <i class="fa-solid fa-calendar-days"></i>
                </span>
                <div>
                    <h2 class="font-semibold text-slate-950">Planning fiable</h2>
                    <p class="mt-1 text-sm leading-6 text-slate-600">Créneaux simples ou de nuit, découpage par jour et mois, repas placés sur le premier segment.</p>
                </div>
            </div>

            <div class="flex items-start gap-3">
                <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-md bg-emerald-100 text-emerald-700">
                    <i class="fa-solid fa-euro-sign"></i>
                </span>
                <div>
                    <h2 class="font-semibold text-slate-950">Paiements verrouillés</h2>
                    <p class="mt-1 text-sm leading-6 text-slate-600">Un mois payé ne peut plus être modifié, et un mois rouvert est recalculé depuis les tarifs historiques.</p>
                </div>
            </div>

            <div class="flex items-start gap-3">
                <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-md bg-violet-100 text-violet-700">
                    <i class="fa-solid fa-user-shield"></i>
                </span>
                <div>
                    <h2 class="font-semibold text-slate-950">Données sensibles isolées</h2>
                    <p class="mt-1 text-sm leading-6 text-slate-600">L'identité de la nounou peut être partagée ; les contrats, tarifs et paiements restent propres à chaque utilisateur.</p>
                </div>
            </div>
        </div>
    </div>
</section>
{% endblock %}
