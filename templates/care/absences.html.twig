{% extends 'base.html.twig' %}
{% import 'components/_icon_action.html.twig' as icons %}
{% block title %}Indisponibilités{% endblock %}
{% block body %}
<div class="space-y-5">
    <div class="flex flex-wrap items-start justify-between gap-3"><div><a href="{{ path('app_care_index', {publicId: nanny.publicId}) }}" class="text-sm text-teal-700">← Planning</a><h1 class="mt-1 text-2xl font-semibold">Absences, congés et fermetures</h1><p class="text-sm text-slate-500">{{ nanny.fullName }} · les conflits sont signalés sans bloquer l’enregistrement.</p></div></div>
    <section class="rounded-lg border border-slate-200 bg-white p-5">
        <h2 class="font-semibold">Ajouter une indisponibilité</h2>
        <form method="post" class="mt-4 grid grid-cols-1 gap-4 md:grid-cols-2 xl:grid-cols-4">
            <input type="hidden" name="_token" value="{{ csrf_token('care_absence_create_' ~ nanny.publicId) }}">
            <label class="text-sm font-medium">Motif<select name="type" required class="mt-1 w-full rounded-md border border-slate-300 px-3 py-2">{% for value,label in types %}<option value="{{ value }}">{{ label }}</option>{% endfor %}</select></label>
            <label class="text-sm font-medium">Début<input type="datetime-local" name="starts_at" required class="mt-1 w-full rounded-md border border-slate-300 px-3 py-2"></label>
            <label class="text-sm font-medium">Fin<input type="datetime-local" name="ends_at" required class="mt-1 w-full rounded-md border border-slate-300 px-3 py-2"></label>
            <label class="flex items-center gap-2 self-end rounded-md border border-slate-200 px-3 py-2 text-sm"><input type="checkbox" name="remunerated" value="1"> Période rémunérée</label>
            <label class="md:col-span-2 xl:col-span-3 text-sm font-medium">Commentaire<textarea name="notes" rows="2" class="mt-1 w-full rounded-md border border-slate-300 px-3 py-2"></textarea></label>
            <button class="self-end rounded-md bg-teal-600 px-4 py-2 text-sm font-semibold text-white">Enregistrer</button>
        </form>
    </section>
    <section class="rounded-lg border border-slate-200 bg-white"><h2 class="border-b border-slate-200 px-5 py-4 font-semibold">Périodes enregistrées</h2><div class="divide-y divide-slate-100">{% for row in rows %}<article class="flex flex-col gap-3 px-5 py-4 sm:flex-row sm:items-center sm:justify-between"><div><p class="font-medium">{{ row.absence.typeLabel }}</p><p class="text-sm text-slate-500">Du {{ row.absence.startsAt|date('d/m/Y H:i') }} au {{ row.absence.endsAt|date('d/m/Y H:i') }} · {{ row.absence.remunerated ? 'rémunérée' : 'non rémunérée' }}</p>{% if row.absence.notes %}<p class="mt-1 text-sm">{{ row.absence.notes }}</p>{% endif %}{% if row.conflicts > 0 %}<p class="mt-2 rounded bg-rose-50 px-2 py-1 text-sm font-medium text-rose-700"><i class="fa-solid fa-triangle-exclamation"></i> {{ row.conflicts }} conflit(s) de garde</p>{% endif %}</div><form method="post" action="{{ path('app_care_absence_archive', {nannyId: nanny.publicId, absenceId: row.absence.publicId}) }}" data-controller="confirm" data-confirm-message-value="Archiver cette période pour mémoire ?"><input type="hidden" name="_token" value="{{ csrf_token('care_absence_archive_' ~ row.absence.publicId) }}">{{ icons.button('box-archive', 'Archiver ' ~ row.absence.typeLabel, 'danger') }}</form></article>{% else %}<p class="p-8 text-center text-sm text-slate-500">Aucune indisponibilité.</p>{% endfor %}</div></section>
</div>
{% endblock %}
