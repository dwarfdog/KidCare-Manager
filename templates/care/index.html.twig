{% extends 'base.html.twig' %}

{% block title %}Planning{% endblock %}

{% block body %}
<div
    class="grid grid-cols-1 gap-4 lg:grid-cols-[20rem_minmax(0,1fr)]"
    data-controller="calendar"
    {% if selected_nanny %}
        data-calendar-events-value="{{ events|json_encode|e('html_attr') }}"
        data-calendar-nanny-id-value="{{ selected_nanny.publicId }}"
        data-calendar-current-date-value="{{ currentDate }}"
        data-calendar-csrf-token-value="{{ csrf_token }}"
        data-calendar-default-start-value="{{ default_start }}"
        data-calendar-default-end-value="{{ default_end }}"
        data-calendar-default-meals-value="{{ default_meals }}"
    {% endif %}
>
    <aside class="rounded-lg border border-slate-200 bg-white p-4">
        <div>
            <h1 class="text-lg font-semibold">Planning</h1>
            {% if selected_nanny %}
                <p class="mt-1 text-sm text-slate-500">{{ selected_nanny.fullName }}</p>
            {% else %}
                <p class="mt-1 text-sm text-slate-500">Selectionnez une nounou.</p>
            {% endif %}
        </div>

        <div class="mt-5">
            <label for="nanny-select" class="text-sm font-medium text-slate-700">Nounou</label>
            <select id="nanny-select" data-action="change->calendar#changeNanny" class="mt-2 w-full rounded-md border border-slate-300 px-3 py-2 text-sm">
                <option value="{{ path('app_care_index') }}" {% if not selected_nanny %}selected{% endif %}>Choisir</option>
                {% for nanny in nannies %}
                    <option value="{{ path('app_care_index', {'publicId': nanny.publicId}) }}" {% if selected_nanny and selected_nanny.publicId == nanny.publicId %}selected{% endif %}>{{ nanny.fullName }}</option>
                {% endfor %}
            </select>
        </div>

        {% if selected_nanny %}
            <div class="mt-6">
                <h2 class="text-sm font-semibold text-slate-700">Outils</h2>
                <div class="mt-2 grid grid-cols-2 gap-2 text-center text-xs font-semibold">
                    <a href="{{ path('app_care_absence_index', {publicId:selected_nanny.publicId}) }}" class="rounded-md border border-slate-300 px-2 py-2 hover:bg-slate-50"><i class="fa-solid fa-calendar-xmark"></i> Indisponibilités</a>
                    <a href="{{ path('app_nanny_documents', {publicId:selected_nanny.publicId}) }}" class="rounded-md border border-slate-300 px-2 py-2 hover:bg-slate-50"><i class="fa-solid fa-file-lines"></i> Documents</a>
                    <a href="{{ path('app_care_calendar_manage', {publicId:selected_nanny.publicId}) }}" class="rounded-md border border-slate-300 px-2 py-2 hover:bg-slate-50"><i class="fa-solid fa-calendar-days"></i> Calendrier ICS</a>
                    <a href="{{ path('app_kidcare_report', {nanny:selected_nanny.publicId}) }}" class="rounded-md border border-slate-300 px-2 py-2 hover:bg-slate-50"><i class="fa-solid fa-chart-column"></i> Rapports</a>
                </div>
            </div>
            <div class="mt-6">
                <h2 class="text-sm font-semibold text-slate-700">Templates</h2>
                <div class="mt-2 space-y-2">
                    {% for template in templates %}
                        <div class="rounded-md border border-slate-300 p-2">
                            <p class="px-1 text-sm font-medium text-slate-800">{{ template.name }}</p>
                            <div class="mt-2 grid grid-cols-2 gap-2">
                                <button
                                    type="button"
                                    class="rounded-md bg-slate-900 px-2 py-1.5 text-xs font-semibold text-white hover:bg-slate-800"
                                    data-action="calendar#applyTemplate"
                                    data-template-url="{{ path('app_care_template_apply', {'publicId': template.publicId}) }}"
                                    data-template-preview-url="{{ path('app_care_template_preview', {'publicId': template.publicId}) }}"
                                    data-template-token="{{ csrf_token('apply_template_' ~ template.publicId) }}"
                                    data-template-week-offset="0"
                                >
                                    Cette semaine
                                </button>
                                <button
                                    type="button"
                                    class="rounded-md border border-slate-300 px-2 py-1.5 text-xs font-semibold hover:bg-slate-50"
                                    data-action="calendar#applyTemplate"
                                    data-template-url="{{ path('app_care_template_apply', {'publicId': template.publicId}) }}"
                                    data-template-preview-url="{{ path('app_care_template_preview', {'publicId': template.publicId}) }}"
                                    data-template-token="{{ csrf_token('apply_template_' ~ template.publicId) }}"
                                    data-template-week-offset="1"
                                >
                                    Semaine suivante
                                </button>
                            </div>
                        </div>
                    {% else %}
                        <div class="rounded-md border border-dashed border-slate-300 px-3 py-4 text-center text-sm text-slate-500">
                            Aucun template.
                        </div>
                    {% endfor %}
                </div>
            </div>
        {% endif %}
    </aside>

    <section class="rounded-lg border border-slate-200 bg-white p-3">
        {% if selected_nanny %}
            <div class="mb-3 grid grid-cols-2 gap-2 md:hidden">
                <button type="button" data-action="calendar#showCalendar" class="rounded-md bg-slate-900 px-3 py-2 text-sm font-semibold text-white"><i class="fa-solid fa-calendar-days"></i> Calendrier</button>
                <button type="button" data-action="calendar#showList" class="rounded-md border border-slate-300 px-3 py-2 text-sm font-semibold"><i class="fa-solid fa-list"></i> Liste</button>
            </div>
            <div data-calendar-target="calendarPanel">
                <div data-calendar-target="calendar" class="min-h-[620px]"></div>
            </div>
            <div data-calendar-target="listPanel" class="hidden md:hidden">
                <div data-calendar-target="list" class="space-y-2"></div>
            </div>
        {% else %}
            <div class="p-10 text-center text-sm text-slate-500">
                <i class="fa-regular fa-calendar mb-2 text-2xl text-slate-300"></i>
                <p>Selectionnez une nounou pour afficher son planning.</p>
            </div>
        {% endif %}
    </section>
</div>
{% endblock %}
