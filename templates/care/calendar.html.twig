{% extends 'base.html.twig' %}
{% block title %}Calendrier privé{% endblock %}
{% block body %}<div class="mx-auto max-w-3xl space-y-5"><div><a href="{{ path('app_care_index', {publicId:nanny.publicId}) }}" class="text-sm text-teal-700">← Planning</a><h1 class="mt-1 text-2xl font-semibold">Calendrier de {{ nanny.fullName }}</h1><p class="text-sm text-slate-500">Le flux contient horaires, montants, motifs et notes privées. Son adresse doit rester confidentielle.</p></div><section class="rounded-lg border border-slate-200 bg-white p-5"><h2 class="font-semibold">Téléchargement ponctuel</h2><a href="{{ path('app_care_calendar_download', {publicId:nanny.publicId}) }}" class="mt-3 inline-flex rounded-md bg-teal-600 px-4 py-2 text-sm font-semibold text-white">Télécharger le fichier ICS</a></section><section class="rounded-lg border border-amber-200 bg-amber-50 p-5"><h2 class="font-semibold text-amber-900">Abonnement privé révocable</h2><label class="mt-3 block text-sm font-medium text-amber-900">Adresse du flux<input readonly value="{{ absolute_url(path('app_care_calendar_feed', {token:subscription.accessToken})) }}" class="mt-1 w-full rounded-md border border-amber-300 bg-white px-3 py-2 font-mono text-xs" onclick="this.select()"></label><form method="post" action="{{ path('app_care_calendar_regenerate', {publicId:nanny.publicId}) }}" class="mt-4" data-controller="confirm" data-confirm-message-value="L’ancienne adresse cessera immédiatement de fonctionner. Continuer ?"><input type="hidden" name="_token" value="{{ csrf_token('calendar_regenerate_' ~ nanny.publicId) }}"><button class="rounded-md border border-amber-400 px-3 py-2 text-sm font-semibold text-amber-900">Révoquer et régénérer</button></form></section></div>{% endblock %}
