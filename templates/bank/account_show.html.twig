{% extends 'base.html.twig' %}

{% block title %}Compte bancaire{% endblock %}

{% block body %}
{% include 'bank/_tabs.html.twig' %}
<div class="space-y-5">
    <section class="rounded-lg border border-slate-200 bg-white p-5">
        <div class="flex flex-wrap items-start justify-between gap-4">
            <div class="min-w-0">
                <div class="flex flex-wrap items-center gap-2">
                    <h1 class="truncate text-xl font-semibold">{{ accountManager.displayName(account) }}</h1>
                    {{ include('bank/_account_type_badge.html.twig', {type: account.type, label: accountManager.typeLabel(account)}) }}
                </div>
                {% if accountManager.displayIban(account) %}
                    <p class="mt-1 break-all text-sm text-slate-500">{{ accountManager.displayIban(account) }}</p>
                {% endif %}
            </div>
            <div class="flex flex-wrap gap-2">
                <a href="{{ path('app_bank_transaction_new') }}" class="rounded-md bg-teal-600 px-3 py-2 text-sm font-semibold text-white shadow-sm hover:bg-teal-700">
                    <i class="fa-solid fa-plus"></i>
                    Operation
                </a>
                <a href="{{ path('app_bank_account_edit', {publicId: account.publicId}) }}" class="rounded-md border border-slate-300 px-3 py-2 text-sm font-semibold text-slate-700 hover:bg-slate-50">Modifier</a>
                {% if account.isLoan() %}
                    <a href="{{ path('app_bank_loans') }}" class="rounded-md border border-amber-300 px-3 py-2 text-sm font-semibold text-amber-800 hover:bg-amber-50">Suivi du pret</a>
                {% endif %}
            </div>
        </div>

        <div class="mt-5 grid grid-cols-1 gap-3 md:grid-cols-3">
            <div class="rounded-md bg-slate-50 p-4">
                <p class="text-sm font-medium text-slate-500">Solde disponible</p>
                <p class="mt-2 text-2xl font-semibold tabular-nums {{ balance < 0 ? 'text-rose-700' : 'text-slate-950' }}">{{ balance|number_format(2, ',', ' ') }} €</p>
            </div>
            <div class="rounded-md bg-indigo-50 p-4">
                <p class="text-sm font-medium text-indigo-700">Solde previsionnel</p>
                {% if projectedBalance is not null %}
                    <p class="mt-2 text-2xl font-semibold tabular-nums {{ projectedBalance < 0 ? 'text-rose-700' : 'text-indigo-900' }}">{{ projectedBalance|number_format(2, ',', ' ') }} €</p>
                    <p class="mt-1 text-xs text-indigo-700">au {{ periodEnd|date('d/m/Y') }}, veille du prochain salaire</p>
                {% else %}
                    <p class="mt-2 text-sm font-medium text-indigo-900">Aucune date de reference</p>
                    <p class="mt-1 text-xs text-indigo-700">Definir un repere de salaire</p>
                {% endif %}
            </div>
            <div class="rounded-md bg-slate-50 p-4">
                <p class="text-sm font-medium text-slate-500">Prevu restant</p>
                {% if plannedTotal is not null %}
                    <p class="mt-2 text-2xl font-semibold tabular-nums {{ plannedTotal < 0 ? 'text-rose-700' : 'text-emerald-700' }}">{{ plannedTotal|number_format(2, ',', ' ') }} €</p>
                    <p class="mt-1 text-xs text-slate-500">jusqu'au {{ periodEnd|date('d/m/Y') }}</p>
                {% else %}
                    <p class="mt-2 text-sm font-medium text-slate-600">Non calcule</p>
                {% endif %}
            </div>
        </div>
    </section>

    <div class="grid grid-cols-1 gap-5 xl:grid-cols-[minmax(0,1fr)_24rem]">
        <section class="rounded-lg border border-slate-200 bg-white">
            <div class="flex flex-wrap items-center justify-between gap-3 border-b border-slate-200 px-5 py-4">
                <div>
                    <h2 class="text-lg font-semibold">Operations realisees</h2>
                    <p class="text-sm text-slate-500">{{ realTransactions|length }} operation{{ realTransactions|length > 1 ? 's' : '' }}</p>
                </div>
                <a href="{{ path('app_bank_transaction_new') }}" class="rounded-md bg-teal-600 px-3 py-2 text-sm font-semibold text-white shadow-sm hover:bg-teal-700">
                    <i class="fa-solid fa-plus"></i>
                    Ajouter
                </a>
            </div>

            <div class="divide-y divide-slate-100">
                {% for transaction in realTransactions %}
                    {% set previous = loop.index0 > 0 ? realTransactions[loop.index0 - 1] : null %}
                    {% if previous is null or transaction.date|date('Y-m') != previous.date|date('Y-m') %}
                        <div class="bg-slate-50 px-5 py-2 text-xs font-semibold uppercase text-slate-500">{{ transaction.date|format_date('none', 'MMMM yyyy', locale='fr') }}</div>
                    {% endif %}
                    <article class="grid grid-cols-1 gap-3 px-5 py-4 hover:bg-slate-50 sm:grid-cols-[6rem_minmax(0,1fr)_auto] sm:items-center">
                        <div class="text-sm font-medium text-slate-500">{{ transaction.date|date('d/m/Y') }}</div>
                        <div class="min-w-0">
                            <a href="{{ path('app_bank_transaction_edit', {publicId: transaction.publicId}) }}" class="block truncate font-medium text-slate-950 hover:text-teal-700">{{ transactionManager.label(transaction) }}</a>
                            <div class="mt-1 flex flex-wrap items-center gap-2 text-xs text-slate-500">
                                {% if transaction.category %}<span>{{ transaction.category.name }}</span>{% endif %}
                                {{ include('bank/_transaction_status_badge.html.twig', {status: transaction.status}) }}
                                {{ include('bank/_transaction_verification_badge.html.twig', {transaction: transaction}) }}
                            </div>
                        </div>
                        <div class="flex items-center justify-between gap-3 sm:justify-end">
                            <span class="whitespace-nowrap text-right text-sm font-semibold tabular-nums {{ transaction.amount < 0 ? 'text-rose-700' : 'text-emerald-700' }}">{{ transaction.amount|number_format(2, ',', ' ') }} €</span>
                        </div>
                    </article>
                {% else %}
                    <p class="px-5 py-8 text-center text-sm text-slate-500">Aucune operation realisee sur ce compte.</p>
                {% endfor %}
            </div>
        </section>

        <aside class="rounded-lg border border-indigo-200 bg-white">
            <div class="border-b border-indigo-100 px-5 py-4">
                <h2 class="text-lg font-semibold text-indigo-950">Operations prevues</h2>
                {% if referenceDate %}
                    <p class="text-sm text-indigo-700">Jusqu'au {{ periodEnd|date('d/m/Y') }} · prochain salaire le {{ referenceDate|date('d/m/Y') }}</p>
                {% else %}
                    <p class="text-sm text-indigo-700">Date de reference manquante</p>
                {% endif %}
            </div>
            <div class="divide-y divide-indigo-50">
                {% if referenceDate is null %}
                    <p class="px-5 py-6 text-sm text-slate-500">Aucune projection affichee sans repere de salaire.</p>
                {% else %}
                    {% for transaction in plannedTransactions %}
                        <article class="px-5 py-4">
                            <div class="flex items-start justify-between gap-3">
                                <div class="min-w-0">
                                    <p class="text-xs font-medium text-indigo-700">{{ transaction.date|date('d/m/Y') }}</p>
                                    <a href="{{ path('app_bank_transaction_edit', {publicId: transaction.publicId}) }}" class="mt-1 block truncate text-sm font-semibold text-slate-950 hover:text-teal-700">{{ transactionManager.label(transaction) }}</a>
                                    <div class="mt-1 flex flex-wrap items-center gap-2 text-xs text-slate-500">
                                        {% if transaction.category %}<span>{{ transaction.category.name }}</span>{% endif %}
                                        {{ include('bank/_transaction_status_badge.html.twig', {status: transaction.status}) }}
                                        {% if transaction.recurringRule and transaction.recurringRule.nextPeriodAttached %}
                                            <span class="inline-flex items-center gap-1 rounded-full bg-indigo-50 px-2 py-0.5 text-xs font-medium text-indigo-700 ring-1 ring-inset ring-indigo-600/20" data-tippy-content="Ce revenu est reserve au budget de la periode suivante: il n'est pas compte dans le previsionnel courant.">
                                                <i class="fa-solid fa-forward text-[10px]"></i>
                                                Periode suivante
                                            </span>
                                        {% endif %}
                                    </div>
                                </div>
                                <span class="whitespace-nowrap text-sm font-semibold tabular-nums {{ transaction.amount < 0 ? 'text-rose-700' : 'text-emerald-700' }}">{{ transaction.amount|number_format(2, ',', ' ') }} €</span>
                            </div>
                        </article>
                    {% else %}
                        <p class="px-5 py-6 text-sm text-slate-500">Aucune operation prevue avant la date de reference.</p>
                    {% endfor %}
                {% endif %}
            </div>
        </aside>
    </div>
</div>
{% endblock %}
