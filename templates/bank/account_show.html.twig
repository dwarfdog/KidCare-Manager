{% extends 'base.html.twig' %}

{% block title %}Compte bancaire{% endblock %}

{% block body %}
{% include 'bank/_tabs.html.twig' %}
<div class="space-y-5">
    <section class="rounded-lg border border-slate-200 bg-white p-5">
        <div class="flex flex-wrap items-start justify-between gap-4">
            <div class="min-w-0">
                <div class="flex flex-wrap items-center gap-2">
                    <h1 class="truncate text-xl font-semibold">{{ accountManager.displayName(account) }}</h1>
                    {{ include('bank/_account_type_badge.html.twig', {type: account.type, label: accountManager.typeLabel(account)}) }}
                </div>
                {% if accountManager.displayIban(account) %}
                    <p class="mt-1 break-all text-sm text-slate-500">{{ accountManager.displayIban(account) }}</p>
                {% endif %}
            </div>
            <div class="flex flex-wrap gap-2">
                <a href="{{ path('app_bank_transaction_new', {account: account.publicId}) }}" class="rounded-md bg-teal-600 px-3 py-2 text-sm font-semibold text-white shadow-sm hover:bg-teal-700">
                    <i class="fa-solid fa-plus"></i> Operation
                </a>
                <a href="{{ path('app_bank_account_edit', {publicId: account.publicId}) }}" class="rounded-md border border-slate-300 px-3 py-2 text-sm font-semibold text-slate-700 hover:bg-slate-50"><i class="fa-solid fa-pen"></i> Modifier</a>
                <a href="{{ path('app_bank_analytics', {accounts: account.publicId}) }}" class="rounded-md border border-teal-300 px-3 py-2 text-sm font-semibold text-teal-800 hover:bg-teal-50"><i class="fa-solid fa-chart-line"></i> Analyser</a>
                {% if account.isLoan() %}
                    <a href="{{ path('app_bank_loans') }}" class="rounded-md border border-amber-300 px-3 py-2 text-sm font-semibold text-amber-800 hover:bg-amber-50"><i class="fa-solid fa-hand-holding-dollar"></i> Suivi du pret</a>
                {% endif %}
            </div>
        </div>

        <div class="mt-5 grid grid-cols-1 gap-3 md:grid-cols-3">
            <div class="rounded-md bg-slate-50 p-4">
                <p class="text-sm font-medium text-slate-500">Solde disponible</p>
                <p class="mt-2 text-2xl font-semibold tabular-nums {{ balance < 0 ? 'text-rose-700' : 'text-slate-950' }}">{{ balance|number_format(2, ',', ' ') }} €</p>
            </div>
            <div class="rounded-md bg-indigo-50 p-4">
                <p class="text-sm font-medium text-indigo-700">Solde previsionnel</p>
                {% if projectedBalance is not null %}
                    <p class="mt-2 text-2xl font-semibold tabular-nums {{ projectedBalance < 0 ? 'text-rose-700' : 'text-indigo-900' }}">{{ projectedBalance|number_format(2, ',', ' ') }} €</p>
                    <p class="mt-1 text-xs text-indigo-700">au {{ periodEnd|date('d/m/Y') }}, veille du prochain salaire</p>
                {% else %}
                    <p class="mt-2 text-sm font-medium text-indigo-900">Aucune date de reference</p>
                    <p class="mt-1 text-xs text-indigo-700">Definir un repere de salaire</p>
                {% endif %}
            </div>
            <div class="rounded-md bg-slate-50 p-4">
                <p class="text-sm font-medium text-slate-500">Prevu restant</p>
                {% if plannedTotal is not null %}
                    <p class="mt-2 text-2xl font-semibold tabular-nums {{ plannedTotal < 0 ? 'text-rose-700' : 'text-emerald-700' }}">{{ plannedTotal|number_format(2, ',', ' ') }} €</p>
                    <p class="mt-1 text-xs text-slate-500">jusqu'au {{ periodEnd|date('d/m/Y') }}</p>
                {% else %}
                    <p class="mt-2 text-sm font-medium text-slate-600">Non calcule</p>
                {% endif %}
            </div>
        </div>
    </section>

    {% if focusMessage %}
        <div class="rounded-md border border-amber-200 bg-amber-50 px-4 py-3 text-sm text-amber-900" role="status">
            <i class="fa-solid fa-circle-info mr-1"></i>{{ focusMessage }}
        </div>
    {% endif %}

    <div class="grid grid-cols-1 gap-5 xl:grid-cols-[minmax(0,1fr)_24rem]">
        {% include 'bank/_account_real_transactions.html.twig' %}
        {% include 'bank/_account_planned_transactions.html.twig' %}
    </div>
</div>
{% endblock %}
