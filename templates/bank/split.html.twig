{% extends 'base.html.twig' %}

{% block title %}Ventiler une opération{% endblock %}

{% block body %}
{% include 'bank/_tabs.html.twig' %}
<div class="mx-auto max-w-4xl space-y-5">
    <div>
        <a href="{{ path('app_bank_transaction_edit', {publicId: transaction.publicId}) }}" class="text-sm text-teal-700">← Opération</a>
        <h1 class="mt-1 text-2xl font-semibold">Ventilation</h1>
        <p class="text-sm text-slate-500">Total parent : <strong>{{ transaction.amount|number_format(2, ',', ' ') }} €</strong>. La somme des lignes doit être strictement identique.</p>
    </div>

    <form method="post" class="space-y-4" data-controller="split-form">
        <input type="hidden" name="_token" value="{{ csrf_token('bank_split_' ~ transaction.publicId) }}">
        <div data-split-form-target="rows" class="space-y-3">
            {% set initial = splits|length ? splits : [null, null] %}
            {% for split in initial %}
                <fieldset class="grid grid-cols-1 gap-3 rounded-lg border border-slate-200 bg-white p-4 sm:grid-cols-[1fr_1fr_10rem_auto]" data-split-row>
                    <legend class="sr-only">Ligne de ventilation {{ loop.index }}</legend>
                    <label class="sr-only" for="split-label-{{ loop.index0 }}">Libellé de la ligne {{ loop.index }}</label>
                    <input id="split-label-{{ loop.index0 }}" name="lines[{{ loop.index0 }}][label]" value="{{ split ? splitManager.label(split) : '' }}" placeholder="Libellé" class="rounded-md border border-slate-300 px-3 py-2">
                    <label class="sr-only" for="split-category-{{ loop.index0 }}">Catégorie de la ligne {{ loop.index }}</label>
                    <select id="split-category-{{ loop.index0 }}" name="lines[{{ loop.index0 }}][category]" required class="rounded-md border border-slate-300 px-3 py-2">
                        <option value="">Catégorie</option>
                        {% for category in categories %}<option value="{{ category.publicId }}" {{ split and split.category == category ? 'selected' }}>{{ category.name }}</option>{% endfor %}
                    </select>
                    <label class="sr-only" for="split-amount-{{ loop.index0 }}">Montant de la ligne {{ loop.index }}</label>
                    <input id="split-amount-{{ loop.index0 }}" type="number" step="0.01" min="0.01" name="lines[{{ loop.index0 }}][amount]" value="{{ split ? split.amount|abs : '' }}" placeholder="Montant" required class="rounded-md border border-slate-300 px-3 py-2">
                    <button type="button" data-action="split-form#remove" class="text-rose-700" aria-label="Retirer la ligne {{ loop.index }}"><i class="fa-solid fa-xmark"></i></button>
                </fieldset>
            {% endfor %}
        </div>

        <template data-split-form-target="template">
            <fieldset class="grid grid-cols-1 gap-3 rounded-lg border border-slate-200 bg-white p-4 sm:grid-cols-[1fr_1fr_10rem_auto]" data-split-row>
                <legend class="sr-only" data-split-legend>Ligne de ventilation</legend>
                <input data-name="label" aria-label="Libellé de la ligne" placeholder="Libellé" class="rounded-md border border-slate-300 px-3 py-2">
                <select data-name="category" aria-label="Catégorie de la ligne" required class="rounded-md border border-slate-300 px-3 py-2">
                    <option value="">Catégorie</option>
                    {% for category in categories %}<option value="{{ category.publicId }}">{{ category.name }}</option>{% endfor %}
                </select>
                <input data-name="amount" aria-label="Montant de la ligne" type="number" step="0.01" min="0.01" placeholder="Montant" required class="rounded-md border border-slate-300 px-3 py-2">
                <button type="button" data-action="split-form#remove" class="text-rose-700" aria-label="Retirer la ligne"><i class="fa-solid fa-xmark"></i></button>
            </fieldset>
        </template>
        <div class="flex flex-wrap gap-3">
            <button type="button" data-action="split-form#add" class="rounded-md border border-slate-300 px-3 py-2 text-sm font-medium">Ajouter une ligne</button>
            <button class="rounded-md bg-teal-600 px-4 py-2 text-sm font-semibold text-white">Enregistrer la ventilation</button>
        </div>
    </form>

    {% if splits|length %}
        <form method="post" action="{{ path('app_bank_transaction_unsplit', {publicId: transaction.publicId}) }}" data-controller="confirm">
            <input type="hidden" name="_token" value="{{ csrf_token('bank_unsplit_' ~ transaction.publicId) }}">
            <button class="text-sm font-medium text-rose-700">Supprimer la ventilation</button>
        </form>
    {% endif %}
</div>
{% endblock %}
