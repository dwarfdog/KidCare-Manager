{% extends 'base.html.twig' %}
{% import 'components/_icon_action.html.twig' as icons %}

{% block title %}Operations recurrentes{% endblock %}

{% block body %}
{% include 'bank/_tabs.html.twig' %}
{% set freq_labels = {'weekly': 'Hebdo', 'monthly': 'Mensuel', 'yearly': 'Annuel', 'custom_days': 'Personnalise'} %}
<div class="grid grid-cols-1 gap-5 lg:grid-cols-3">
    <div class="space-y-4 lg:col-span-2">
        {# Filtres #}
        <form method="get" class="flex flex-wrap items-end gap-3 rounded-lg border border-slate-200 bg-white p-4">
            <div>
                <label for="recurring-filter-account" class="mb-1 block text-xs font-medium text-slate-500">Compte</label>
                <select id="recurring-filter-account" name="account" class="rounded-md border border-slate-300 px-2 py-1.5 text-sm">
                    <option value="">Tous</option>
                    {% for account in accounts %}
                        <option value="{{ account.publicId }}" {{ filters.account == account.publicId ? 'selected' }}>{{ accountManager.displayName(account) }}</option>
                    {% endfor %}
                </select>
            </div>
            <div>
                <label for="recurring-filter-category" class="mb-1 block text-xs font-medium text-slate-500">Categorie</label>
                <select id="recurring-filter-category" name="category" class="rounded-md border border-slate-300 px-2 py-1.5 text-sm">
                    <option value="">Toutes</option>
                    {% for category in categories %}
                        <option value="{{ category.publicId }}" {{ filters.category == category.publicId ? 'selected' }}>{{ category.name }}</option>
                    {% endfor %}
                </select>
            </div>
            <div>
                <label for="recurring-filter-direction" class="mb-1 block text-xs font-medium text-slate-500">Sens</label>
                <select id="recurring-filter-direction" name="direction" class="rounded-md border border-slate-300 px-2 py-1.5 text-sm">
                    <option value="">Tous</option>
                    <option value="income" {{ filters.direction == 'income' ? 'selected' }}>Revenus</option>
                    <option value="expense" {{ filters.direction == 'expense' ? 'selected' }}>Depenses</option>
                </select>
            </div>
            <button class="rounded-md bg-slate-800 px-3 py-1.5 text-sm font-semibold text-white hover:bg-slate-700">Filtrer</button>
            <a href="{{ path('app_bank_recurring') }}" class="px-2 py-1.5 text-sm font-medium text-slate-500 hover:text-slate-800">Reinitialiser</a>
        </form>

        <div class="rounded-lg border border-slate-200 bg-white">
            <div class="border-b border-slate-200 px-5 py-4"><h1 class="text-lg font-semibold">Operations recurrentes</h1></div>
            <div class="divide-y divide-slate-100">
                {% for rule in rules %}
                    <div class="flex flex-wrap items-center justify-between gap-3 px-5 py-4 text-sm">
                        <div class="min-w-0">
                            <p class="flex items-center gap-2 font-medium">
                                {{ encryption.decrypt(rule.encryptedLabel) }}
                                {% if rule.salaryReference %}<span class="rounded-full bg-emerald-50 px-2 py-0.5 text-[10px] font-semibold text-emerald-700 ring-1 ring-inset ring-emerald-600/20" data-tippy-content="Repere de salaire: sa prochaine occurrence marque le debut de la periode suivante"><i class="fa-solid fa-star"></i> Salaire</span>{% endif %}
                                {% if rule.income and rule.nextPeriodAttached %}<span class="rounded-full bg-indigo-50 px-2 py-0.5 text-[10px] font-semibold text-indigo-700 ring-1 ring-inset ring-indigo-600/20" data-tippy-content="Revenu reserve au budget de la periode suivante: exclu du previsionnel courant"><i class="fa-solid fa-forward"></i> Periode suivante</span>{% endif %}
                            </p>
                            <p class="text-xs text-slate-500">{{ freq_labels[rule.frequency]|default(rule.frequency) }} · {{ accountManager.displayName(rule.account) }} · depuis {{ rule.startDate|date('d/m/Y') }}{% if rule.endDate %} → {{ rule.endDate|date('d/m/Y') }}{% endif %}</p>
                        </div>
                        <div class="flex items-center gap-3">
                            <span class="font-semibold tabular-nums {{ rule.amount < 0 ? 'text-rose-700' : 'text-emerald-700' }}">{{ rule.amount|number_format(2, ',', ' ') }} €</span>
                            {{ icons.link('pen', 'Modifier ' ~ encryption.decrypt(rule.encryptedLabel), path('app_bank_recurring_edit', {publicId: rule.publicId})) }}
                            <form method="post" action="{{ path('app_bank_recurring_deactivate', {publicId: rule.publicId}) }}"
                                  data-controller="confirm" data-confirm-title-value="Archiver cette recurrence ?" data-confirm-text-value="Les echeances prevues seront retirees du budget. La recurrence restera consultable dans les Archives, sans possibilite de restauration." data-confirm-confirm-text-value="Archiver" data-action="confirm#submit">
                                <input type="hidden" name="_token" value="{{ csrf_token('bank_recurring_deactivate_' ~ rule.publicId) }}">
                                {{ icons.button('box-archive', 'Archiver ' ~ encryption.decrypt(rule.encryptedLabel), 'danger') }}
                            </form>
                        </div>
                    </div>
                {% else %}
                    <p class="px-5 py-8 text-center text-sm text-slate-500">Aucune recurrence active pour ces criteres.</p>
                {% endfor %}
            </div>
        </div>
    </div>

    <div class="rounded-lg border border-slate-200 bg-white p-5">
        <h2 class="mb-4 text-base font-semibold">Nouvelle recurrence</h2>
        {{ form_start(form) }}
            {{ form_widget(form) }}
            <button class="mt-2 w-full rounded-md bg-teal-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-teal-700">Enregistrer</button>
        {{ form_end(form) }}
    </div>
</div>
{% endblock %}
