{% set styles = {
    'current': 'bg-teal-50 text-teal-700 ring-teal-600/20',
    'savings': 'bg-indigo-50 text-indigo-700 ring-indigo-600/20',
    'deferred_card': 'bg-violet-50 text-violet-700 ring-violet-600/20',
    'credit': 'bg-orange-50 text-orange-700 ring-orange-600/20',
    'loan': 'bg-amber-50 text-amber-800 ring-amber-600/20',
    'cash': 'bg-slate-100 text-slate-700 ring-slate-500/20',
} %}
<span class="inline-flex items-center rounded-full px-2 py-0.5 text-xs font-medium ring-1 ring-inset {{ styles[type]|default('bg-slate-100 text-slate-700 ring-slate-500/20') }}">{{ label }}</span>
