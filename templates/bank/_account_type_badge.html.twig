{% set styles = {
    'current': 'bg-teal-50 text-teal-700 ring-teal-600/20',
    'savings': 'bg-indigo-50 text-indigo-700 ring-indigo-600/20',
    'deferred_card': 'bg-violet-50 text-violet-700 ring-violet-600/20',
    'credit': 'bg-orange-50 text-orange-700 ring-orange-600/20',
    'loan': 'bg-amber-50 text-amber-800 ring-amber-600/20',
    'cash': 'bg-slate-100 text-slate-700 ring-slate-500/20',
} %}
{% set icons = {
    'current': 'building-columns',
    'savings': 'piggy-bank',
    'deferred_card': 'credit-card',
    'credit': 'money-check',
    'loan': 'hand-holding-dollar',
    'cash': 'money-bill-wave',
} %}
<span class="inline-flex h-7 w-7 items-center justify-center rounded-full ring-1 ring-inset {{ styles[type]|default('bg-slate-100 text-slate-700 ring-slate-500/20') }}" data-tippy-content="{{ label }}" aria-label="{{ label }}">
    <i class="fa-solid fa-{{ icons[type]|default('tag') }} text-xs"></i>
</span>
