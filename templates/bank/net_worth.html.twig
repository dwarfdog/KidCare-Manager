{% extends 'base.html.twig' %}{% block title %}Patrimoine net{% endblock %}{% block body %}{% include 'bank/_tabs.html.twig' %}<div class="space-y-5"><div><h1 class="text-2xl font-semibold">Patrimoine net</h1><p class="text-sm text-slate-500">Comptes et prêts bancaires complétés par vos actifs et dettes manuels.</p></div><div class="grid grid-cols-2 gap-3 lg:grid-cols-5">{% for label,value in {'Comptes':snapshot.accountAssets,'Actifs manuels':snapshot.manualAssets,'Prêts/découverts':-snapshot.bankDebts,'Dettes manuelles':-snapshot.manualDebts,'Patrimoine net':snapshot.net} %}<div class="rounded-lg border border-slate-200 bg-white p-4"><p class="text-xs text-slate-500">{{label}}</p><p class="mt-1 text-lg font-semibold {{value<0?'text-rose-700':'text-slate-900'}}">{{value|number_format(2,',',' ')}} €</p></div>{% endfor %}</div><form method="post" class="grid grid-cols-1 gap-3 rounded-lg border border-slate-200 bg-white p-4 sm:grid-cols-5"><input type="hidden" name="_token" value="{{csrf_token('bank_asset_save')}}"><label class="text-sm font-medium">Nom<input name="name" required class="mt-1 w-full rounded border border-slate-300 px-3 py-2"></label><label class="text-sm font-medium">Type<select name="type" class="mt-1 w-full rounded border border-slate-300 px-3 py-2"><option value="asset">Actif</option><option value="debt">Dette</option></select></label><label class="text-sm font-medium">Valeur<input type="number" step="0.01" min="0" name="value" required class="mt-1 w-full rounded border border-slate-300 px-3 py-2"></label><label class="text-sm font-medium">Date<input type="date" name="date" value="{{'now'|date('Y-m-d')}}" class="mt-1 w-full rounded border border-slate-300 px-3 py-2"></label><button class="self-end rounded-md bg-teal-600 px-4 py-2 text-sm font-semibold text-white">Ajouter</button></form><section class="rounded-lg border border-slate-200 bg-white"><div class="divide-y divide-slate-100">{% for a in assets %}<div class="flex items-center justify-between px-5 py-3"><div><p class="font-medium">{{a.name}}</p><p class="text-sm text-slate-500">{{a.type=='debt'?'Dette':'Actif'}} · {{a.currentValue|number_format(2,',',' ')}} €</p></div><form method="post" action="{{path('app_bank_asset_archive',{publicId:a.publicId})}}"><input type="hidden" name="_token" value="{{csrf_token('bank_asset_archive_'~a.publicId)}}"><button class="text-sm text-rose-700">Archiver</button></form></div>{% else %}<p class="p-5 text-sm text-slate-500">Aucun élément manuel.</p>{% endfor %}</div></section><section class="rounded-lg border border-slate-200 bg-white p-5"><h2 class="font-semibold">Évolution des valeurs manuelles</h2>{% if history.values|length > 0 %}<div class="mt-4 h-72" data-controller="bank-chart" data-bank-chart-type-value="line" data-bank-chart-labels-value="{{history.labels|json_encode|e('html_attr')}}" data-bank-chart-values-value="{{history.values|json_encode|e('html_attr')}}"><canvas data-bank-chart-target="canvas"></canvas></div>{% else %}<p class="mt-4 text-sm text-slate-500">Ajoute un element manuel pour voir son evolution ici.</p>{% endif %}</section></div>{% endblock %}
