{# Badge cliquable: bascule le statut Verifiee/Non verifiee apres confirmation. #}
<form method="post" action="{{ path('app_bank_transaction_verification', {publicId: transaction.publicId}) }}" class="inline-flex"
      data-controller="confirm"
      data-action="submit->confirm#submit"
      data-confirm-title-value="{{ transaction.verified ? 'Marquer cette operation comme non verifiee ?' : 'Verifier cette operation ?' }}"
      data-confirm-confirm-text-value="{{ transaction.verified ? 'Retirer la verification' : 'Verifier' }}">
    <input type="hidden" name="_token" value="{{ csrf_token('bank_transaction_verify_' ~ transaction.publicId) }}">
    <input type="hidden" name="verified" value="{{ transaction.verified ? '0' : '1' }}">
    {% if return_context|default(null) == 'account' %}
        <input type="hidden" name="return_context" value="account">
        {% for name, value in return_params|default([]) %}
            <input type="hidden" name="return[{{ name }}]" value="{{ value }}">
        {% endfor %}
    {% endif %}
    {% if transaction.verified %}
        <button type="submit" class="inline-flex h-7 w-7 cursor-pointer items-center justify-center rounded-full bg-emerald-50 text-emerald-700 ring-1 ring-inset ring-emerald-600/20 hover:bg-emerald-100" aria-label="Verifiee" data-tippy-content="Verifiee le {{ transaction.verifiedAt|date('d/m/Y H:i') }} — cliquer pour retirer la verification">
            <i class="fa-regular fa-square-check text-xs"></i>
        </button>
    {% else %}
        <button type="submit" class="inline-flex h-7 w-7 cursor-pointer items-center justify-center rounded-full bg-amber-50 text-amber-700 ring-1 ring-inset ring-amber-600/20 hover:bg-amber-100" aria-label="Non verifiee" data-tippy-content="Non verifiee — cliquer pour verifier cette operation">
            <i class="fa-regular fa-square text-xs"></i>
        </button>
    {% endif %}
</form>
