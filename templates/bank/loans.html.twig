{% extends 'base.html.twig' %}

{% block title %}Prets{% endblock %}

{% block body %}
{% include 'bank/_tabs.html.twig' %}
<div class="space-y-5">
    {# Totaux consolides #}
    <div class="grid grid-cols-1 gap-4 sm:grid-cols-3">
        <div class="rounded-lg border border-slate-200 bg-white p-4">
            <p class="text-sm font-medium text-slate-500">Capital restant total</p>
            <p class="mt-2 text-2xl font-semibold tabular-nums text-amber-800">{{ overview.total_remaining|number_format(2, ',', ' ') }} €</p>
            {% if overview.total_initial > 0 %}<p class="mt-1 text-xs text-slate-400">sur {{ overview.total_initial|number_format(2, ',', ' ') }} € empruntes</p>{% endif %}
        </div>
        <div class="rounded-lg border border-slate-200 bg-white p-4">
            <p class="text-sm font-medium text-slate-500">Mensualites cumulees</p>
            <p class="mt-2 text-2xl font-semibold tabular-nums">{{ overview.total_monthly|number_format(2, ',', ' ') }} €</p>
            <p class="mt-1 text-xs text-slate-400">par mois</p>
        </div>
        <div class="rounded-lg border border-slate-200 bg-white p-4">
            <p class="text-sm font-medium text-slate-500">Derniere echeance estimee</p>
            <p class="mt-2 text-2xl font-semibold tabular-nums capitalize">{{ overview.last_due_date ? overview.last_due_date|format_date('none', 'MMMM yyyy', locale='fr') : '—' }}</p>
        </div>
    </div>

    <div class="rounded-lg border border-slate-200 bg-white">
        <div class="flex items-center justify-between border-b border-slate-200 px-5 py-4">
            <h1 class="text-lg font-semibold">Suivi des prets</h1>
            <a href="{{ path('app_bank_account_new') }}" class="rounded-md bg-teal-600 px-3 py-2 text-sm font-semibold text-white shadow-sm hover:bg-teal-700"><i class="fa-solid fa-plus"></i> Nouveau pret</a>
        </div>
        <div class="divide-y divide-slate-100">
            {% for loan in overview.loans %}
                <div class="px-5 py-4">
                    <div class="flex flex-wrap items-start justify-between gap-3">
                        <div>
                            <a href="{{ path('app_bank_account_show', {publicId: loan.account.publicId}) }}" class="font-semibold hover:text-teal-700">{{ loan.name }}</a>
                            <p class="text-xs text-slate-500">
                                {% if loan.monthly %}{{ loan.monthly|number_format(2, ',', ' ') }} €/mois{% endif %}
                                {% if loan.payment_day %} · le {{ loan.payment_day }} du mois{% endif %}
                                {% if loan.debit_account %} · debite sur {{ accountManager.displayName(loan.debit_account) }}{% endif %}
                                {% if loan.rate %} · {{ loan.rate|number_format(2, ',', ' ') }} %{% endif %}
                            </p>
                            {% if not loan.debit_account or not loan.monthly or not loan.payment_day %}
                                <p class="mt-1 text-xs font-medium text-amber-600"><i class="fa-solid fa-triangle-exclamation"></i> <a href="{{ path('app_bank_account_edit', {publicId: loan.account.publicId}) }}" class="underline">Complete mensualite, jour et compte a debiter</a> pour activer le decompte automatique.</p>
                            {% endif %}
                        </div>
                        <div class="text-right">
                            <p class="text-lg font-semibold tabular-nums text-amber-800">{{ loan.remaining|number_format(2, ',', ' ') }} €</p>
                            <p class="text-xs text-slate-500">capital restant</p>
                        </div>
                    </div>

                    <div class="mt-3 grid grid-cols-2 gap-3 rounded-md bg-slate-50 p-3 text-sm sm:grid-cols-4">
                        <div><p class="text-xs text-slate-500">Mensualites restantes</p><p class="font-semibold tabular-nums">{{ loan.months_left ?? '—' }}</p></div>
                        <div><p class="text-xs text-slate-500">Derniere mensualite</p><p class="font-semibold tabular-nums">{{ loan.last_payment ? loan.last_payment|number_format(2, ',', ' ') ~ ' €' : '—' }}</p></div>
                        <div><p class="text-xs text-slate-500">Derniere echeance</p><p class="font-semibold capitalize">{{ loan.last_due_date ? loan.last_due_date|format_date('none', 'MMM yyyy', locale='fr') : '—' }}</p></div>
                        <div><p class="text-xs text-slate-500">Prochaine</p><p class="font-semibold">{{ loan.next_payment_date ? loan.next_payment_date|date('d/m/Y') : '—' }}</p></div>
                    </div>

                    {% if loan.initial and loan.initial > 0 %}
                        <div class="mt-3">
                            <div class="mb-1 flex justify-between text-xs text-slate-500">
                                <span>Rembourse {{ loan.progress|number_format(0) }} %</span>
                                <span>{{ (loan.initial - loan.remaining)|number_format(0, ',', ' ') }} / {{ loan.initial|number_format(0, ',', ' ') }} €</span>
                            </div>
                            <div class="h-2 rounded-full bg-slate-100">
                                <div class="h-2 rounded-full bg-amber-500" style="width: {{ loan.progress }}%"></div>
                            </div>
                        </div>
                    {% endif %}
                </div>
            {% else %}
                <p class="px-5 py-10 text-center text-sm text-slate-500">
                    Aucun pret. Cree un compte de type « Pret » pour suivre son remboursement.
                </p>
            {% endfor %}
        </div>
    </div>
</div>
{% endblock %}
