{% extends 'base.html.twig' %}{% block title %}Rapprochement bancaire{% endblock %}{% block body %}{% include 'bank/_tabs.html.twig' %}<div class="space-y-5"><div><h1 class="text-2xl font-semibold">Rapprochement bancaire</h1><p class="text-sm text-slate-500">CSV à virgule, point-virgule ou tabulation. Aucune opération n’est rapprochée avant votre validation finale.</p></div>{% if not inspection %}<form method="post" enctype="multipart/form-data" class="grid gap-4 rounded-lg border border-slate-200 bg-white p-5 sm:grid-cols-3"><input type="hidden" name="_token" value="{{csrf_token('bank_reconciliation')}}"><input type="hidden" name="phase" value="upload"><label class="text-sm font-medium">Compte<select name="account" required class="mt-1 w-full rounded border border-slate-300 px-3 py-2">{% for a in accounts %}<option value="{{a.publicId}}">{{accountManager.displayName(a)}}</option>{% endfor %}</select></label><label class="text-sm font-medium">Relevé CSV<input type="file" name="statement" accept=".csv,text/csv,text/plain" required class="mt-2 block w-full"></label><button class="self-end rounded-md bg-teal-600 px-4 py-2 text-sm font-semibold text-white">Analyser</button></form>{% elseif candidates is null %}<form method="post" class="grid gap-4 rounded-lg border border-slate-200 bg-white p-5 sm:grid-cols-4"><input type="hidden" name="_token" value="{{csrf_token('bank_reconciliation')}}"><input type="hidden" name="phase" value="map"><input type="hidden" name="account" value="{{selectedAccount.publicId}}">{% for key,label in {date_column:'Colonne date',amount_column:'Colonne montant',label_column:'Colonne libellé'} %}<label class="text-sm font-medium">{{label}}<select name="{{key}}" required class="mt-1 w-full rounded border border-slate-300 px-3 py-2">{% for h in inspection.headers %}<option value="{{h}}">{{h}}</option>{% endfor %}</select></label>{% endfor %}<label class="text-sm font-medium">Format de date<select name="date_format" class="mt-1 w-full rounded border border-slate-300 px-3 py-2"><option value="d/m/Y">JJ/MM/AAAA</option><option value="Y-m-d">AAAA-MM-JJ</option><option value="d-m-Y">JJ-MM-AAAA</option></select></label><button class="rounded-md bg-teal-600 px-4 py-2 text-sm font-semibold text-white sm:col-start-4">Rechercher les correspondances</button></form>{% else %}<form method="post" class="rounded-lg border border-slate-200 bg-white"><input type="hidden" name="_token" value="{{csrf_token('bank_reconciliation')}}"><input type="hidden" name="phase" value="confirm"><input type="hidden" name="account" value="{{selectedAccount.publicId}}"><div class="overflow-x-auto"><table class="min-w-full text-sm"><thead class="bg-slate-50"><tr><th class="px-3 py-2">Valider</th><th class="px-3 py-2 text-left">Ligne relevé</th><th class="px-3 py-2 text-left">Meilleure opération</th><th class="px-3 py-2">Score</th></tr></thead><tbody class="divide-y divide-slate-100">{% for row in candidates %}<tr><td class="px-3 py-3 text-center">{% if row.transaction %}<input type="checkbox" name="transactions[]" value="{{row.transaction.publicId}}" {{row.score>=70?'checked':''}}>{% endif %}</td><td class="px-3 py-3">{{row.date}} · {{row.label}} · {{row.amount|number_format(2,',',' ')}} €</td><td class="px-3 py-3">{% if row.transaction %}{{row.transaction.date|date('d/m/Y')}} · {{row.transaction.amount|number_format(2,',',' ')}} €{% else %}<label class="inline-flex items-center gap-2 text-slate-500"><input type="checkbox" name="create_rows[]" value="{{loop.index0}}"> Aucune correspondance — créer cette opération</label>{% endif %}</td><td class="px-3 py-3 text-center">{% if row.transaction %}<span class="rounded px-2 py-1 {{row.score>=70?'bg-emerald-100 text-emerald-800':'bg-amber-100 text-amber-800'}}">{{row.score}}</span>{% endif %}</td></tr>{% endfor %}</tbody></table></div><div class="border-t border-slate-200 p-4 text-right"><button class="rounded-md bg-teal-600 px-4 py-2 text-sm font-semibold text-white">Valider définitivement la sélection</button></div></form>{% endif %}</div>{% endblock %}
