{% set labels = {
    'planned': 'Prevue',
    'real': 'Reelle',
    'reconciled': 'Reelle',
} %}
{% set icons = {
    'planned': 'spinner',
    'real': 'calendar-check',
    'reconciled': 'link',
} %}
{% set styles = {
    'planned': 'bg-indigo-50 text-indigo-700 ring-indigo-600/20',
    'real': 'bg-emerald-50 text-emerald-700 ring-emerald-600/20',
    'reconciled': 'bg-emerald-50 text-emerald-700 ring-emerald-600/20',
} %}
{% set tooltip = status == 'planned' ? 'Prevue — pas encore realisee' : (status == 'reconciled' ? 'Reelle — rapprochee avec un releve bancaire' : 'Reelle — operation effectuee') %}
<span class="inline-flex h-7 w-7 items-center justify-center rounded-full ring-1 ring-inset {{ styles[status]|default('bg-slate-100 text-slate-700 ring-slate-500/20') }}" data-tippy-content="{{ tooltip }}" aria-label="{{ labels[status]|default(status) }}">
    <i class="fa-solid fa-{{ icons[status]|default('circle') }} text-xs"></i>
</span>
