{% extends 'base.html.twig' %}{% block title %}Simulation de trésorerie{% endblock %}{% block body %}{% include 'bank/_tabs.html.twig' %}<div class="space-y-5"><div><h1 class="text-2xl font-semibold">Simulation de trésorerie</h1><p class="text-sm text-slate-500">Solde courant, opérations prévues, récurrences et hypothèses manuelles.</p></div><form method="post" class="space-y-4 rounded-lg border border-slate-200 bg-white p-5" data-controller="simulation-form"><input type="hidden" name="_token" value="{{ csrf_token('bank_simulation') }}"><div class="grid grid-cols-1 gap-3 sm:grid-cols-3"><label class="text-sm font-medium">Horizon<select name="horizon" class="mt-1 w-full rounded-md border border-slate-300 px-3 py-2">{% for value,label in horizons %}<option value="{{ value }}" {{ horizon==value?'selected':'' }}>{{ label }}</option>{% endfor %}</select></label><label class="text-sm font-medium">Nom pour enregistrer<input name="name" class="mt-1 w-full rounded-md border border-slate-300 px-3 py-2"></label><label class="flex items-end gap-2 pb-2 text-sm"><input type="checkbox" name="save" value="1"> Enregistrer cette simulation</label></div><div data-simulation-form-target="rows" class="space-y-2">{% for item in assumptions %}<fieldset class="grid grid-cols-1 gap-2 rounded-md border border-slate-200 p-3 sm:grid-cols-[1fr_1fr_8rem_auto]" data-simulation-row><legend class="sr-only">Hypothèse {{ loop.index }}</legend><input aria-label="Date de l'hypothèse {{ loop.index }}" type="date" name="assumptions[{{loop.index0}}][date]" value="{{item.date|default('')}}" class="rounded border border-slate-300 px-2 py-1"><input aria-label="Libellé de l'hypothèse {{ loop.index }}" name="assumptions[{{loop.index0}}][label]" value="{{item.label|default('')}}" placeholder="Hypothèse" class="rounded border border-slate-300 px-2 py-1"><input aria-label="Montant de l'hypothèse {{ loop.index }}" type="number" step="0.01" name="assumptions[{{loop.index0}}][amount]" value="{{item.amount|default('')}}" placeholder="± montant" class="rounded border border-slate-300 px-2 py-1"><button type="button" aria-label="Retirer l'hypothèse {{ loop.index }}" data-action="simulation-form#remove">×</button></fieldset>{% endfor %}</div><button type="button" data-action="simulation-form#add" class="rounded-md border border-slate-300 px-3 py-2 text-sm">Ajouter une hypothèse</button><button class="rounded-md bg-teal-600 px-4 py-2 text-sm font-semibold text-white">Calculer</button></form>{% if result %}<section class="grid grid-cols-2 gap-3 lg:grid-cols-5">{% for label,value in {'Solde actuel':result.startBalance,'Prévisions existantes':result.planned,'Récurrences projetées':result.recurring,'Hypothèses':result.manual,'Résultat':result.result} %}<div class="rounded-lg border border-slate-200 bg-white p-4"><p class="text-sm text-slate-500">{{label}}</p><p class="text-xl font-semibold {{value<0?'text-rose-700':''}}">{{value|number_format(2,',',' ')}} €</p></div>{% endfor %}</section>{% endif %}<section class="rounded-lg border border-slate-200 bg-white"><h2 class="border-b border-slate-200 px-5 py-4 font-semibold">Simulations enregistrées</h2><div class="divide-y divide-slate-100">{% for s in saved %}<div class="flex justify-between px-5 py-3"><a href="{{ path('app_bank_simulations',{load:s.publicId}) }}" class="font-medium text-teal-700">{{s.name}}</a><form method="post" action="{{path('app_bank_simulation_archive',{publicId:s.publicId})}}"><input type="hidden" name="_token" value="{{csrf_token('bank_simulation_archive_'~s.publicId)}}"><button class="text-sm text-rose-700">Archiver</button></form></div>{% else %}<p class="p-5 text-sm text-slate-500">Aucune simulation enregistrée.</p>{% endfor %}</div></section></div>{% endblock %}
