{% extends 'base.html.twig' %}

{% block title %}{{ title }}{% endblock %}

{% block body %}
{% include 'bank/_tabs.html.twig' %}
<div class="mx-auto max-w-2xl rounded-lg border border-slate-200 bg-white p-6 shadow-sm">
    <h1 class="mb-6 text-lg font-semibold">{{ title }}</h1>
    {{ form_start(form) }}
        {{ form_widget(form) }}
        <div class="mt-2 flex flex-wrap gap-3">
            <button class="rounded-md bg-teal-600 px-4 py-2 text-sm font-semibold text-white hover:bg-teal-700">Enregistrer</button>
            <a href="{{ path('app_bank_index') }}" class="rounded-md border border-slate-300 px-4 py-2 text-sm font-semibold text-slate-700 hover:bg-slate-50">Annuler</a>
        </div>
    {{ form_end(form) }}
</div>
{% endblock %}
