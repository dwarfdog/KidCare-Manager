{% set current_route = app.request.attributes.get('_route')|default('') %}
{% set groups = {
    comptes: {
        label: 'Comptes',
        icon: 'building-columns',
        active: current_route starts with 'app_bank_account' or current_route starts with 'app_bank_loans' or current_route starts with 'app_bank_transfer',
        items: [
            {route: 'app_bank_accounts', prefix: 'app_bank_account', label: 'Comptes', icon: 'building-columns'},
            {route: 'app_bank_loans', prefix: 'app_bank_loans', label: 'Prets', icon: 'hand-holding-dollar'},
            {route: 'app_bank_transfer_new', prefix: 'app_bank_transfer', label: 'Virements', icon: 'right-left'},
        ],
    },
    suivi: {
        label: 'Suivi',
        icon: 'chart-line',
        active: current_route starts with 'app_bank_budgets' or current_route starts with 'app_bank_goals' or current_route starts with 'app_bank_analytics' or current_route starts with 'app_bank_net_worth',
        items: [
            {route: 'app_bank_budgets', prefix: 'app_bank_budgets', label: 'Budgets', icon: 'scale-balanced'},
            {route: 'app_bank_goals', prefix: 'app_bank_goals', label: 'Objectifs', icon: 'bullseye'},
            {route: 'app_bank_analytics', prefix: 'app_bank_analytics', label: 'Analyses', icon: 'chart-pie'},
            {route: 'app_bank_net_worth', prefix: 'app_bank_net_worth', label: 'Patrimoine', icon: 'sack-dollar'},
        ],
    },
    outils: {
        label: 'Outils',
        icon: 'toolbox',
        active: current_route starts with 'app_bank_import' or current_route starts with 'app_bank_categories' or current_route starts with 'app_bank_category_rule' or current_route starts with 'app_bank_reconciliation' or current_route starts with 'app_bank_simulation' or current_route starts with 'app_bank_alert',
        items: [
            {route: 'app_bank_import', prefix: 'app_bank_import', label: 'Import', icon: 'file-import'},
            {route: 'app_bank_categories', prefix: 'app_bank_categories', label: 'Categories', icon: 'tags'},
            {route: 'app_bank_category_rules', prefix: 'app_bank_category_rule', label: 'Règles', icon: 'code-branch'},
            {route: 'app_bank_reconciliation', prefix: 'app_bank_reconciliation', label: 'Rapprochement', icon: 'file-invoice'},
            {route: 'app_bank_simulations', prefix: 'app_bank_simulation', label: 'Simulations', icon: 'wand-magic-sparkles'},
            {route: 'app_bank_alerts', prefix: 'app_bank_alert', label: 'Alertes', icon: 'bell'},
        ],
    },
} %}
<div class="mb-4">
<div class="border-b border-slate-200">
    <nav class="flex flex-wrap items-center gap-1 text-sm">
        <a href="{{ path('app_bank_index') }}" class="px-3 py-2 font-medium {{ current_route == 'app_bank_index' ? 'border-b-2 border-teal-600 text-teal-700' : 'text-slate-600 hover:text-slate-950' }}">Tableau</a>
        <a href="{{ path('app_bank_transactions') }}" class="px-3 py-2 font-medium {{ current_route starts with 'app_bank_transaction' ? 'border-b-2 border-teal-600 text-teal-700' : 'text-slate-600 hover:text-slate-950' }}">Operations</a>
        <a href="{{ path('app_bank_recurring') }}" class="px-3 py-2 font-medium {{ current_route starts with 'app_bank_recurring' ? 'border-b-2 border-teal-600 text-teal-700' : 'text-slate-600 hover:text-slate-950' }}">Recurrences</a>
        {% for key, group in groups %}
            <div class="relative" x-data="{ open: false }" @click.away="open = false">
                <button type="button" @click="open = !open" :aria-expanded="open.toString()" class="flex items-center gap-1.5 px-3 py-2 font-medium {{ group.active ? 'border-b-2 border-teal-600 text-teal-700' : 'text-slate-600 hover:text-slate-950' }}">
                    <i class="fa-solid fa-{{ group.icon }} text-xs"></i>
                    {{ group.label }}
                    <i class="fa-solid fa-chevron-down text-[10px]" :class="open ? 'rotate-180' : ''"></i>
                </button>
                <div x-show="open" x-cloak x-transition class="absolute left-0 top-full z-20 mt-1 w-52 rounded-md border border-slate-200 bg-white py-1 shadow-lg">
                    {% for item in group.items %}
                        <a href="{{ path(item.route) }}" @click="open = false" class="flex items-center gap-2 px-4 py-2 text-sm {{ current_route starts with item.prefix ? 'bg-slate-100 font-medium text-teal-700' : 'text-slate-700 hover:bg-slate-50' }}">
                            <i class="fa-solid fa-{{ item.icon }} w-4 text-center text-xs"></i>
                            {{ item.label }}
                        </a>
                    {% endfor %}
                </div>
            </div>
        {% endfor %}
    </nav>
</div>
</div>
