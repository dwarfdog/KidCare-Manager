        <a href="{{ path('app_bank_accounts') }}" class="px-3 py-2 font-medium {{ current_route starts with 'app_bank_account' ? 'border-b-2 border-teal-600 text-teal-700' : 'text-slate-600 hover:text-slate-950' }}">Comptes</a>
