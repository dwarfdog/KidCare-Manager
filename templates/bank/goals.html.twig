{% extends 'base.html.twig' %}

{% block title %}Objectifs financiers{% endblock %}

{% block body %}
{% include 'bank/_tabs.html.twig' %}

<div class="mb-5 rounded-lg border border-teal-200 bg-teal-50" x-data="{ open: false }">
    <button type="button" class="flex w-full items-center justify-between gap-3 px-5 py-3 text-left" x-on:click="open = !open">
        <span class="flex items-center gap-2 text-sm font-semibold text-teal-900">
            <i class="fa-regular fa-circle-question"></i>
            Comment fonctionnent les objectifs ?
        </span>
        <i class="fa-solid text-xs text-teal-700" x-bind:class="open ? 'fa-chevron-up' : 'fa-chevron-down'"></i>
    </button>
    <div x-show="open" x-cloak class="border-t border-teal-200 px-5 py-4 text-sm text-teal-900">
        <p class="mb-2"><strong>A quoi ca sert ?</strong> Un objectif represente une somme a atteindre (vacances, matelas de securite, gros achat...) et suit ta progression vers cette cible.</p>
        <ul class="mb-2 list-disc space-y-1 pl-5">
            <li><strong>Suivi automatique</strong> : lie l'objectif a un compte (un livret par exemple) et le montant actuel suivra son solde, sans aucune saisie.</li>
            <li><strong>Suivi manuel</strong> : sans compte lie, utilise le bouton « Alimenter » pour ajouter ce que tu mets de cote.</li>
            <li><strong>Date cible</strong> : si tu en definis une, l'epargne mensuelle necessaire pour arriver a temps est calculee automatiquement.</li>
            <li><strong>Objectif atteint</strong> : des que le montant cible est atteint, l'objectif passe automatiquement en « Atteint ».</li>
        </ul>
        <p>L'alimentation manuelle est un suivi virtuel : elle ne cree aucune operation bancaire.</p>
    </div>
</div>

<div class="grid grid-cols-1 gap-5 lg:grid-cols-3">
    <div class="rounded-lg border border-slate-200 bg-white lg:col-span-2">
        <div class="border-b border-slate-200 px-5 py-4">
            <h1 class="text-lg font-semibold">Objectifs financiers</h1>
            <p class="text-sm text-slate-500">Progression vers chaque somme a atteindre.</p>
        </div>
        <div class="divide-y divide-slate-100">
            {% for row in goalRows %}
                <div class="px-5 py-4 text-sm">
                    <div class="flex flex-wrap items-start justify-between gap-3">
                        <div class="min-w-0">
                            <p class="flex flex-wrap items-center gap-2 font-medium">
                                {{ row.goal.name }}
                                {% if row.achieved %}
                                    <span class="inline-flex items-center gap-1 rounded-full bg-emerald-50 px-2 py-0.5 text-xs font-medium text-emerald-700 ring-1 ring-inset ring-emerald-600/20"><i class="fa-solid fa-trophy text-[10px]"></i> Atteint</span>
                                {% elseif row.target_date_passed %}
                                    <span class="inline-flex items-center rounded-full bg-amber-50 px-2 py-0.5 text-xs font-medium text-amber-700 ring-1 ring-inset ring-amber-600/20">Date cible depassee</span>
                                {% endif %}
                            </p>
                            <p class="mt-0.5 text-xs text-slate-500">
                                {% if row.goal.linkedAccount %}
                                    <i class="fa-solid fa-link text-[10px]"></i> Suit le solde de « {{ accountManager.displayName(row.goal.linkedAccount) }} »
                                {% else %}
                                    Suivi manuel
                                {% endif %}
                                {% if row.goal.targetDate %} · cible au {{ row.goal.targetDate|date('d/m/Y') }}{% endif %}
                            </p>
                        </div>
                        <div class="text-right">
                            <p class="font-semibold tabular-nums">{{ row.current|number_format(2, ',', ' ') }} / {{ row.goal.targetAmount|number_format(2, ',', ' ') }} €</p>
                            <p class="text-xs text-slate-500">{{ row.rate|number_format(0) }} %{% if not row.achieved %} · reste {{ row.remaining|number_format(2, ',', ' ') }} €{% endif %}</p>
                        </div>
                    </div>
                    <div class="mt-3 h-2 rounded-full bg-slate-100">
                        <div class="h-2 rounded-full {{ row.achieved ? 'bg-emerald-500' : 'bg-teal-600' }}" style="width: {{ row.rate }}%"></div>
                    </div>
                    {% if row.monthly_needed is not null %}
                        <p class="mt-2 text-xs text-slate-500"><i class="fa-regular fa-lightbulb"></i> Mets de cote ~{{ row.monthly_needed|number_format(2, ',', ' ') }} € par mois pour atteindre la cible a temps.</p>
                    {% endif %}
                    <div class="mt-2 flex flex-wrap items-center justify-between gap-3">
                        <div>
                            {% if row.goal.linkedAccount is null and not row.achieved %}
                                <form method="post" action="{{ path('app_bank_goal_feed', {publicId: row.goal.publicId}) }}" class="flex items-center gap-2">
                                    <input type="hidden" name="_token" value="{{ csrf_token('bank_goal_feed_' ~ row.goal.publicId) }}">
                                    <input type="number" name="amount" step="0.01" min="0.01" required placeholder="Montant" aria-label="Montant à ajouter à l'objectif {{ row.goal.name }}" class="w-28 rounded-md border-slate-300 text-xs">
                                    <button class="rounded-md border border-teal-300 px-2.5 py-1.5 text-xs font-semibold text-teal-700 hover:bg-teal-50">
                                        <i class="fa-solid fa-plus"></i> Alimenter
                                    </button>
                                </form>
                            {% endif %}
                        </div>
                        <span class="flex items-center gap-3 text-xs">
                            <a href="{{ path('app_bank_goal_edit', {publicId: row.goal.publicId}) }}" class="font-medium text-teal-700 hover:text-teal-900">Modifier</a>
                            <form method="post" action="{{ path('app_bank_goal_archive', {publicId: row.goal.publicId}) }}"
                                  data-controller="confirm"
                                  data-action="submit->confirm#submit"
                                  data-confirm-title-value="Archiver cet objectif ?"
                                  data-confirm-text-value="Il ne sera plus suivi ni affiche sur le tableau de bord."
                                  data-confirm-confirm-text-value="Archiver">
                                <input type="hidden" name="_token" value="{{ csrf_token('bank_goal_archive_' ~ row.goal.publicId) }}">
                                <button class="font-medium text-rose-600 hover:text-rose-800">Archiver</button>
                            </form>
                        </span>
                    </div>
                </div>
            {% else %}
                <div class="px-5 py-10 text-center text-sm text-slate-500">
                    <p class="font-medium text-slate-700">Aucun objectif pour le moment.</p>
                    <p class="mt-1">Cree ton premier objectif avec le formulaire ci-contre, par exemple un matelas de securite.</p>
                </div>
            {% endfor %}
        </div>
    </div>
    <div class="rounded-lg border border-slate-200 bg-white p-5">
        <h2 class="mb-4 text-base font-semibold">Nouvel objectif</h2>
        {{ form_start(form, {attr: {class: 'space-y-4'}}) }}
            {{ include('bank/_goal_form_fields.html.twig', {form: form}) }}
            <button class="rounded-md bg-teal-600 px-4 py-2 text-sm font-semibold text-white hover:bg-teal-700">Enregistrer</button>
        {{ form_end(form) }}
    </div>
</div>
{% endblock %}
