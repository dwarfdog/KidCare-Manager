{% extends 'base.html.twig' %}{% block title %}Règles de catégorisation{% endblock %}{% block body %}{% include 'bank/_tabs.html.twig' %}<div class="space-y-5"><div><h1 class="text-2xl font-semibold">Règles de catégorisation</h1><p class="text-sm text-slate-500">Appliquées aux imports et aux opérations manuelles sans catégorie. Une règle de compte et une correspondance précise sont prioritaires.</p></div><form method="post" class="grid grid-cols-1 gap-3 rounded-lg border border-slate-200 bg-white p-4 md:grid-cols-3"><input type="hidden" name="_token" value="{{ csrf_token('bank_rule_create') }}"><label class="text-sm font-medium">Correspondance<select name="match_type" class="mt-1 w-full rounded-md border border-slate-300 px-3 py-2"><option value="exact">Libellé exact</option><option value="starts">Commence par</option><option value="contains" selected>Contient</option><option value="regex">Expression régulière</option></select></label><label class="text-sm font-medium">Motif<input name="pattern" required class="mt-1 w-full rounded-md border border-slate-300 px-3 py-2"></label><label class="text-sm font-medium">Catégorie<select name="category" required class="mt-1 w-full rounded-md border border-slate-300 px-3 py-2">{% for c in categories %}<option value="{{ c.publicId }}">{{ c.name }}</option>{% endfor %}</select></label><label class="text-sm font-medium">Compte facultatif<select name="account" class="mt-1 w-full rounded-md border border-slate-300 px-3 py-2"><option value="">Tous</option>{% for a in accounts %}<option value="{{ a.publicId }}">{{ accountManager.displayName(a) }}</option>{% endfor %}</select></label><label class="text-sm font-medium">Montant min.<input name="minimum_amount" type="number" step="0.01" min="0" class="mt-1 w-full rounded-md border border-slate-300 px-3 py-2"></label><label class="text-sm font-medium">Montant max.<input name="maximum_amount" type="number" step="0.01" min="0" class="mt-1 w-full rounded-md border border-slate-300 px-3 py-2"></label><label class="text-sm font-medium">Priorité<input name="priority" type="number" value="100" min="0" class="mt-1 w-full rounded-md border border-slate-300 px-3 py-2"></label><button class="self-end rounded-md bg-teal-600 px-4 py-2 text-sm font-semibold text-white">Créer la règle</button></form><section class="rounded-lg border border-slate-200 bg-white"><div class="divide-y divide-slate-100">{% for r in rules %}<article class="flex flex-col gap-3 px-5 py-4 sm:flex-row sm:items-center sm:justify-between"><div><p class="font-medium">{{ r.matchType }} « {{ r.pattern }} » → {{ r.category.name }}</p><p class="text-sm text-slate-500">{{ r.account?accountManager.displayName(r.account):'Tous les comptes' }} · priorité {{ r.priority }}{% if r.minimumAmount is not null or r.maximumAmount is not null %} · {{ r.minimumAmount|default(0) }} à {{ r.maximumAmount|default('∞') }} €{% endif %}</p></div><form method="post" action="{{ path('app_bank_category_rule_archive',{publicId:r.publicId}) }}"><input type="hidden" name="_token" value="{{ csrf_token('bank_rule_archive_'~r.publicId) }}"><button class="text-sm font-medium text-rose-700">Archiver</button></form></article>{% else %}<p class="p-8 text-center text-sm text-slate-500">Aucune règle.</p>{% endfor %}</div></section></div>{% endblock %}
