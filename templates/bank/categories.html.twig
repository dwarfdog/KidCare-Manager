{% extends 'base.html.twig' %}

{% block title %}Categories bancaires{% endblock %}

{% block body %}
{% include 'bank/_tabs.html.twig' %}
<div class="grid grid-cols-1 gap-5 lg:grid-cols-3">
    <div class="rounded-lg border border-slate-200 bg-white lg:col-span-2">
        <div class="border-b border-slate-200 px-5 py-4">
            <h1 class="text-lg font-semibold">Categories</h1>
        </div>
        <div class="divide-y divide-slate-100">
            {% for category in categories %}
                <div class="flex flex-col gap-3 px-5 py-3 text-sm sm:flex-row sm:items-center sm:justify-between">
                    <div class="flex min-w-0 items-center gap-3">
                        <span class="h-3 w-3 rounded-full" style="background: {{ category.color }}"></span>
                        <span class="font-medium">{{ category.name }}</span>
                    </div>
                    <div class="flex flex-wrap items-center gap-x-3 gap-y-2">
                        <span class="text-slate-500">{{ category.type }}</span>
                        {% if category.publicId in analyticsCategoryIds %}
                            <a href="{{ path('app_bank_analytics', {category: category.publicId}) }}" class="font-medium text-indigo-700 hover:text-indigo-900">Evolution</a>
                        {% endif %}
                        <a href="{{ path('app_bank_category_edit', {publicId: category.publicId}) }}" class="font-medium text-teal-700 hover:text-teal-900">Modifier</a>
                        <form method="post" action="{{ path('app_bank_category_archive', {publicId: category.publicId}) }}">
                            <input type="hidden" name="_token" value="{{ csrf_token('bank_category_archive_' ~ category.publicId) }}">
                            <button class="font-medium text-rose-700 hover:text-rose-900">Archiver</button>
                        </form>
                    </div>
                </div>
            {% else %}
                <p class="px-5 py-8 text-center text-sm text-slate-500">Aucune categorie.</p>
            {% endfor %}
        </div>
    </div>
    <div class="rounded-lg border border-slate-200 bg-white p-5">
        <h2 class="mb-4 text-base font-semibold">Nouvelle categorie</h2>
        {{ form_start(form, {attr: {class: 'space-y-4'}}) }}
            {{ form_widget(form) }}
            <button class="rounded-md bg-teal-600 px-4 py-2 text-sm font-semibold text-white hover:bg-teal-700">Ajouter</button>
        {{ form_end(form) }}
    </div>
</div>
{% endblock %}
