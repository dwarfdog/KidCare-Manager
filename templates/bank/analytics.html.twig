{% extends 'base.html.twig' %}

{% block title %}Analyse par categorie{% endblock %}

{% block body %}
{% include 'bank/_tabs.html.twig' %}
<div class="space-y-5" data-controller="bank-category-evolution"
     data-bank-category-evolution-endpoint-value="{{ path('app_bank_analytics_data') }}"
     data-bank-category-evolution-favorite-endpoint-value="{{ path('app_bank_analytics_favorite') }}"
     data-bank-category-evolution-csrf-value="{{ csrf_token('bank_analytics_favorite') }}"
     data-bank-category-evolution-initial-value="{{ analyticsData|json_encode|e('html_attr') }}">
    <section class="rounded-lg border border-slate-200 bg-white p-5">
        <div class="flex flex-wrap items-start justify-between gap-3">
            <div>
                <p class="text-sm font-semibold uppercase tracking-wide text-teal-700">Bank Manager</p>
                <h1 class="mt-1 text-2xl font-semibold">Evolution par categorie</h1>
                <p class="mt-1 text-sm text-slate-500">Gains, depenses et solde mensuel sur les comptes actifs.</p>
            </div>
        </div>

        <form method="get" class="mt-5 flex flex-wrap items-end gap-3" data-bank-category-evolution-target="form" data-action="submit->bank-category-evolution#submit change->bank-category-evolution#change">
            <label class="text-sm font-medium text-slate-700">Categorie
                <select name="category" class="mt-1 rounded-md border border-slate-300 px-3 py-2 text-sm">
                    {% for category in categories %}<option value="{{ category.publicId }}" {{ selectedCategory and selectedCategory.publicId == category.publicId ? 'selected' }}>{{ category.name }}</option>{% endfor %}
                </select>
            </label>
            <label class="text-sm font-medium text-slate-700">Periode
                <select name="period" class="mt-1 rounded-md border border-slate-300 px-3 py-2 text-sm">
                    <option value="6" {{ period == '6' ? 'selected' }}>6 mois</option>
                    <option value="12" {{ period == '12' ? 'selected' }}>12 mois</option>
                    <option value="custom" {{ period == 'custom' ? 'selected' }}>Personnalisee</option>
                </select>
            </label>
            <label class="text-sm font-medium text-slate-700 {{ period != 'custom' ? 'hidden' }}" data-bank-category-evolution-target="customPeriod">Du
                <input type="date" name="from" value="{{ from|date('Y-m-d') }}" class="mt-1 rounded-md border border-slate-300 px-3 py-2 text-sm">
            </label>
            <label class="text-sm font-medium text-slate-700 {{ period != 'custom' ? 'hidden' }}" data-bank-category-evolution-target="customPeriod">Au
                <input type="date" name="to" value="{{ to|date('Y-m-d') }}" class="mt-1 rounded-md border border-slate-300 px-3 py-2 text-sm">
            </label>
            <div class="text-sm font-medium text-slate-700" x-data="{ open: false, selected: {{ selectedAccountIds|json_encode }} }" @click.away="open = false">
                Comptes
                <div class="relative mt-1 w-48">
                    <button type="button" @click="open = !open" :aria-expanded="open.toString()" class="flex w-full items-center justify-between rounded-md border border-slate-300 bg-white px-3 py-2 text-left text-sm font-normal text-slate-700">
                        <span x-text="selected.length + ' compte' + (selected.length > 1 ? 's' : '')"></span>
                        <i class="fa-solid fa-chevron-down text-xs" :class="open ? 'rotate-180' : ''"></i>
                    </button>
                    <div x-show="open" x-cloak x-transition class="absolute left-0 top-full z-20 mt-1 max-h-56 w-64 overflow-y-auto rounded-md border border-slate-200 bg-white p-2 shadow-lg">
                        {% for account in accounts %}
                            <label class="flex items-center gap-2 rounded px-2 py-1.5 text-sm font-normal hover:bg-slate-50">
                                <input type="checkbox" name="accounts[]" value="{{ account.publicId }}" {{ account.publicId in selectedAccountIds ? 'checked' }}
                                       @change="$event.target.checked ? selected.push('{{ account.publicId }}') : selected = selected.filter(id => id !== '{{ account.publicId }}')"
                                       class="rounded border-slate-300 text-teal-600 focus:ring-teal-500">
                                {{ accountManager.displayName(account) }}
                            </label>
                        {% endfor %}
                    </div>
                </div>
            </div>
            <button class="rounded-md bg-teal-600 px-4 py-2 text-sm font-semibold text-white hover:bg-teal-700">Actualiser</button>
        </form>
    </section>

    {% if favorites is not empty %}<section class="rounded-lg border border-slate-200 bg-white p-4"><h2 class="text-sm font-semibold">Vues favorites</h2><div class="mt-2 flex flex-wrap gap-2">{% for favorite in favorites %}<span class="inline-flex items-center gap-1 rounded-md border border-slate-300"><a href="{{ path('app_bank_analytics', favorite.filters) }}" class="px-3 py-1.5 text-sm text-teal-700">{{ favorite.name }}</a><form method="post" action="{{ path('app_bank_analytics_favorite_delete',{publicId:favorite.publicId}) }}" class="pr-2"><input type="hidden" name="_token" value="{{ csrf_token('bank_analytics_favorite_delete_'~favorite.publicId) }}"><button aria-label="Supprimer la vue favorite" class="text-slate-400 hover:text-rose-700">×</button></form></span>{% endfor %}</div></section>{% endif %}

    <div data-bank-category-evolution-target="error" class="{{ analyticsError ? '' : 'hidden' }} rounded-md border border-amber-200 bg-amber-50 px-4 py-3 text-sm text-amber-900" role="alert">{{ analyticsError }}</div>
    <div data-bank-category-evolution-target="empty" class="{{ not analyticsError and not analyticsData.hasData ? '' : 'hidden' }} rounded-md border border-slate-200 bg-white px-5 py-10 text-center text-sm text-slate-500">Aucune donnee exploitable pour cette selection et cette periode.</div>

    <section data-bank-category-evolution-target="result" class="{{ analyticsData.hasData ? '' : 'hidden' }} rounded-lg border border-slate-200 bg-white p-5">
        <div class="mb-4 flex flex-wrap justify-end gap-2"><button type="button" data-action="bank-category-evolution#downloadPng" class="rounded border border-slate-300 px-3 py-2 text-sm">PNG</button><button type="button" data-action="bank-category-evolution#downloadCsv" class="rounded border border-slate-300 px-3 py-2 text-sm">CSV</button><button type="button" data-action="bank-category-evolution#printPdf" class="rounded border border-slate-300 px-3 py-2 text-sm">PDF</button><button type="button" data-action="bank-category-evolution#saveFavorite" class="rounded border border-teal-300 px-3 py-2 text-sm text-teal-700">Enregistrer la vue</button></div>
        <div class="h-80"><canvas data-bank-category-evolution-target="canvas"></canvas></div>
        <p class="sr-only" aria-live="polite" data-bank-category-evolution-target="status"></p>
        <div class="mt-6 overflow-x-auto">
            <table class="min-w-full divide-y divide-slate-200 text-sm">
                <thead class="bg-slate-50"><tr><th class="px-3 py-2 text-left">Mois</th><th class="px-3 py-2 text-right">Gains</th><th class="px-3 py-2 text-right">Depenses</th><th class="px-3 py-2 text-right">Solde</th></tr></thead>
                <tbody class="divide-y divide-slate-100" data-bank-category-evolution-target="table">
                    {% for row in analyticsData.rows %}
                        <tr>
                            <td class="px-3 py-2">{{ row.month }}</td>
                            <td class="px-3 py-2 text-right tabular-nums">{{ row.gains|number_format(2, ',', ' ') }} €</td>
                            <td class="px-3 py-2 text-right tabular-nums">{{ row.expenses|number_format(2, ',', ' ') }} €</td>
                            <td class="px-3 py-2 text-right tabular-nums">{{ row.balance|number_format(2, ',', ' ') }} €</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </section>
</div>
{% endblock %}
