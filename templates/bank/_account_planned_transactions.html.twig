<aside id="planned-transactions"
       class="rounded-lg border border-indigo-200 bg-white"
       data-controller="bank-transaction-list"
       data-bank-transaction-list-section-value="planned"
       data-bank-transaction-list-endpoint-value="{{ path('app_bank_account_transactions', {publicId: account.publicId, section: 'planned'}) }}"
       data-bank-transaction-list-focus-value="{{ focusId|default('') }}">
    <div class="border-b border-indigo-100 px-5 py-4">
        <h2 class="text-lg font-semibold text-indigo-950">Operations prevues</h2>
        {% if referenceDate %}<p class="text-sm text-indigo-700">Jusqu'au {{ periodEnd|date('d/m/Y') }} · prochain salaire le {{ referenceDate|date('d/m/Y') }}</p>{% else %}<p class="text-sm text-indigo-700">Date de reference manquante</p>{% endif %}
        <form method="get" action="{{ path('app_bank_account_show', {publicId: account.publicId}) }}" class="mt-4 grid grid-cols-2 gap-2" data-bank-transaction-list-target="form" data-action="submit->bank-transaction-list#submit change->bank-transaction-list#change">
            <label class="text-xs font-medium text-slate-600">Du<input type="date" name="planned_from" value="{{ plannedCriteria.from ? plannedCriteria.from|date('Y-m-d') : '' }}" class="mt-1 w-full rounded-md border border-slate-300 px-2 py-1.5 text-sm"></label>
            <label class="text-xs font-medium text-slate-600">Au<input type="date" name="planned_to" value="{{ plannedCriteria.to ? plannedCriteria.to|date('Y-m-d') : '' }}" class="mt-1 w-full rounded-md border border-slate-300 px-2 py-1.5 text-sm"></label>
            <label class="text-xs font-medium text-slate-600">Categorie<select name="planned_category" class="mt-1 w-full rounded-md border border-slate-300 px-2 py-1.5 text-sm"><option value="">Toutes</option>{% for category in categories %}<option value="{{ category.publicId }}" {{ plannedCriteria.category and plannedCriteria.category.publicId == category.publicId ? 'selected' }}>{{ category.name }}</option>{% endfor %}</select></label>
            <label class="text-xs font-medium text-slate-600">Type<select name="planned_type" class="mt-1 w-full rounded-md border border-slate-300 px-2 py-1.5 text-sm"><option value="">Tous</option>{% for value, label in transactionTypes %}<option value="{{ value }}" {{ plannedCriteria.type == value ? 'selected' }}>{{ label }}</option>{% endfor %}</select></label>
            <label class="text-xs font-medium text-slate-600">Tri<select name="planned_sort" class="mt-1 w-full rounded-md border border-slate-300 px-2 py-1.5 text-sm"><option value="date" {{ plannedCriteria.sort == 'date' ? 'selected' }}>Date</option><option value="amount" {{ plannedCriteria.sort == 'amount' ? 'selected' }}>Montant</option><option value="category" {{ plannedCriteria.sort == 'category' ? 'selected' }}>Categorie</option></select></label>
            <label class="text-xs font-medium text-slate-600">Ordre<select name="planned_direction" class="mt-1 w-full rounded-md border border-slate-300 px-2 py-1.5 text-sm"><option value="asc" {{ plannedCriteria.direction == 'asc' ? 'selected' }}>Croissant</option><option value="desc" {{ plannedCriteria.direction == 'desc' ? 'selected' }}>Decroissant</option></select></label>
            <div class="col-span-2 flex gap-2"><button class="rounded-md bg-indigo-900 px-3 py-1.5 text-sm font-semibold text-white">Appliquer</button><a href="{{ path('app_bank_account_show', {publicId: account.publicId}) }}" class="rounded-md border border-slate-300 px-3 py-1.5 text-sm font-semibold text-slate-700">Effacer</a></div>
        </form>
    </div>
    <div class="divide-y divide-indigo-50" data-bank-transaction-list-target="content">
        {% if referenceDate is null %}
            <p class="px-5 py-6 text-sm text-slate-500">Aucune projection affichee sans repere de salaire.</p>
        {% else %}
            {% for transaction in plannedTransactions %}
                <article id="bank-transaction-{{ transaction.publicId }}" tabindex="-1" class="bank-transaction-row px-5 py-4">
                    <div class="flex items-start justify-between gap-3">
                        <div class="min-w-0">
                            <p class="text-xs font-medium text-indigo-700">{{ transaction.date|date('d/m/Y') }}</p>
                            <a href="{{ path('app_bank_transaction_edit', {publicId: transaction.publicId}) }}" class="mt-1 block truncate text-sm font-semibold text-slate-950 hover:text-teal-700">{{ transactionManager.label(transaction) }}</a>
                            <div class="mt-1 flex flex-wrap items-center gap-2 text-xs text-slate-500">{% if transaction.category %}<span class="inline-flex items-center gap-1">{{ include('bank/_category_icon.html.twig', {icon: transaction.category.icon, color: transaction.category.color, size: 'h-4 w-4'}) }} {{ transaction.category.name }}</span>{% endif %}{{ include('bank/_transaction_status_badge.html.twig', {status: transaction.status}) }}</div>
                        </div>
                        <span class="whitespace-nowrap text-sm font-semibold tabular-nums {{ transaction.amount < 0 ? 'text-rose-700' : 'text-emerald-700' }}">{{ transaction.amount|number_format(2, ',', ' ') }} €</span>
                    </div>
                </article>
            {% else %}<p class="px-5 py-6 text-sm text-slate-500">Aucune operation prevue pour ces filtres avant la date de reference.</p>{% endfor %}
        {% endif %}
    </div>
</aside>
