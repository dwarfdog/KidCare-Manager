{% extends 'base.html.twig' %}

{% block title %}Nouvelle nounou{% endblock %}

{% block body %}
<div class="mx-auto max-w-2xl rounded-lg border border-slate-200 bg-white p-6">
    <h1 class="text-xl font-semibold">Nouvelle nounou</h1>
    {{ form_start(form, {'attr': {'class': 'mt-6 space-y-4'}}) }}
        <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
            {{ form_row(form.firstname, {'attr': {'class': 'w-full rounded-md border border-slate-300 px-3 py-2'}}) }}
            {{ form_row(form.lastname, {'attr': {'class': 'w-full rounded-md border border-slate-300 px-3 py-2'}}) }}
            {{ form_row(form.addressLine1, {'attr': {'class': 'w-full rounded-md border border-slate-300 px-3 py-2'}}) }}
            {{ form_row(form.addressLine2, {'attr': {'class': 'w-full rounded-md border border-slate-300 px-3 py-2'}}) }}
            {{ form_row(form.postalCode, {'attr': {'class': 'w-full rounded-md border border-slate-300 px-3 py-2'}}) }}
            {{ form_row(form.city, {'attr': {'class': 'w-full rounded-md border border-slate-300 px-3 py-2'}}) }}
            <div class="sm:col-span-2">{{ form_row(form.country, {'attr': {'class': 'w-full rounded-md border border-slate-300 px-3 py-2'}}) }}</div>
        </div>
        <div class="flex justify-end gap-3 pt-2">
            <a href="{{ path('app_nanny_index') }}" class="rounded-md border border-slate-300 px-4 py-2 text-sm font-medium">Annuler</a>
            <button class="rounded-md bg-teal-600 px-4 py-2 text-sm font-semibold text-white">Creer</button>
        </div>
    {{ form_end(form) }}
</div>
{% endblock %}
