{% extends 'base.html.twig' %}
{% block title %}Documents privés{% endblock %}
{% block body %}
{% set labels = {identity:'Identité',contract:'Contrat',certificate:'Attestation',sick_leave:'Arrêt maladie',medical_nanny:'Avis médecin nounou',medical_child:'Avis médecin enfant'} %}
<div class="space-y-5"><div><a href="{{ path('app_nanny_index') }}" class="text-sm text-teal-700">← Nounous</a><h1 class="mt-1 text-2xl font-semibold">Documents privés</h1><p class="text-sm text-slate-500">{{ nanny.fullName }} · PDF chiffrés, visibles uniquement par votre famille.</p></div>
<section class="rounded-lg border border-slate-200 bg-white p-5"><form method="post" enctype="multipart/form-data" class="grid grid-cols-1 gap-4 md:grid-cols-4"><input type="hidden" name="_token" value="{{ csrf_token('nanny_document_add_' ~ nanny.publicId) }}"><label class="text-sm font-medium">Type<select name="type" class="mt-1 w-full rounded-md border border-slate-300 px-3 py-2">{% for type in types %}<option value="{{ type }}">{{ labels[type] }}</option>{% endfor %}</select></label><label class="text-sm font-medium md:col-span-2">Document PDF (10 Mo max.)<input type="file" name="document" accept="application/pdf,.pdf" required class="mt-1 block w-full text-sm"></label><label class="text-sm font-medium">Échéance éventuelle<input type="date" name="expires_at" class="mt-1 w-full rounded-md border border-slate-300 px-3 py-2"></label><button class="rounded-md bg-teal-600 px-4 py-2 text-sm font-semibold text-white md:col-start-4">Chiffrer et ajouter</button></form></section>
<section class="rounded-lg border border-slate-200 bg-white"><div class="divide-y divide-slate-100">{% for row in rows %}<article class="flex flex-col gap-3 px-5 py-4 sm:flex-row sm:items-center sm:justify-between"><div><p class="font-medium">{{ row.name }}</p><p class="text-sm text-slate-500">{{ labels[row.document.type] }} · {{ (row.document.sizeBytes / 1024)|number_format(0, ',', ' ') }} Ko{% if row.document.expiresAt %} · échéance {{ row.document.expiresAt|date('d/m/Y') }}{% endif %}</p></div><div class="flex gap-3"><a class="text-sm font-medium text-teal-700" href="{{ path('app_nanny_document_download', {documentId: row.document.publicId}) }}">Télécharger</a><form method="post" action="{{ path('app_nanny_document_archive', {documentId: row.document.publicId}) }}" data-controller="confirm" data-confirm-message-value="Archiver ce document ?"><input type="hidden" name="_token" value="{{ csrf_token('nanny_document_archive_' ~ row.document.publicId) }}"><button class="text-sm font-medium text-rose-700">Archiver</button></form></div></article>{% else %}<p class="p-8 text-center text-sm text-slate-500">Aucun document.</p>{% endfor %}</div></section></div>
{% endblock %}
