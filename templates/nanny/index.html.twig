{% extends 'base.html.twig' %}

{% block title %}Nounous{% endblock %}

{% block body %}
<div class="space-y-6">
    <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
        <div>
            <h1 class="text-2xl font-semibold">Nounous</h1>
            <p class="text-sm text-slate-500">Identites partagees, contrats et rattachements prives.</p>
        </div>
        <a href="{{ path('app_nanny_new') }}" class="inline-flex items-center justify-center rounded-md bg-teal-600 px-4 py-2 text-sm font-semibold text-white hover:bg-teal-700">
            <i class="fa-solid fa-plus mr-2"></i>Nouvelle nounou
        </a>
    </div>

    <div class="grid grid-cols-1 gap-4 lg:grid-cols-3">
        <div class="rounded-lg border border-slate-200 bg-white p-5 lg:col-span-2">
            <h2 class="text-base font-semibold">Mes rattachements</h2>
            <div class="mt-4 grid grid-cols-1 gap-4 md:grid-cols-2">
                {% for nanny in nannies %}
                    {% set rates = rates_by_nanny[nanny.publicId] ?? [] %}
                    <article class="rounded-lg border border-slate-200 p-4">
                        <div class="flex items-start justify-between gap-3">
                            <div class="min-w-0">
                                <h3 class="font-semibold">{{ nanny.fullName }}</h3>
                                <p class="text-sm text-slate-500">
                                    {{ [nanny.postalCode, nanny.city]|filter(v => v)|join(' ')|default('Adresse non renseignee') }}
                                </p>
                                <div class="mt-2">
                                    {% if rates|length > 0 %}
                                        <span class="inline-flex items-center gap-1.5 rounded-full bg-teal-50 px-2.5 py-1 text-xs font-semibold text-teal-700 ring-1 ring-inset ring-teal-600/20">
                                            <span class="h-1.5 w-1.5 rounded-full bg-teal-500"></span>
                                            Tarif configure
                                        </span>
                                    {% else %}
                                        <span class="inline-flex items-center gap-1.5 rounded-full bg-amber-50 px-2.5 py-1 text-xs font-semibold text-amber-700 ring-1 ring-inset ring-amber-600/20">
                                            <span class="h-1.5 w-1.5 rounded-full bg-amber-500"></span>
                                            Tarif manquant
                                        </span>
                                    {% endif %}
                                </div>
                            </div>
                            <a href="{{ path('app_care_index', {'publicId': nanny.publicId}) }}" class="shrink-0 text-sm font-medium text-teal-700 hover:text-teal-900">Planning</a>
                        </div>

                        <div class="mt-4 space-y-2 text-sm">
                            <p class="font-medium text-slate-700">Code de rattachement</p>
                            <code class="block rounded bg-slate-100 px-2 py-1 text-xs">{{ nanny.inviteCode }}</code>
                        </div>

                        <div class="mt-4">
                            <p class="text-sm font-medium text-slate-700">Tarifs</p>
                            <div class="mt-2 space-y-1">
                                {% for rate in rates %}
                                    <div class="flex flex-col gap-2 rounded-md border border-slate-100 bg-slate-50 px-3 py-2 text-sm sm:flex-row sm:items-center sm:justify-between">
                                        <span>Depuis {{ rate.effectiveFrom|date('d/m/Y') }} : {{ rate.hourlyRate|number_format(2, ',', ' ') }} {{ currency }}/h, repas {{ rate.mealRate|number_format(2, ',', ' ') }} {{ currency }}</span>
                                        <div class="flex shrink-0 gap-2">
                                            <a href="{{ path('app_nanny_rate_edit', {'publicId': nanny.publicId, 'ratePublicId': rate.publicId}) }}" class="font-medium text-slate-700 hover:text-slate-950">Modifier</a>
                                            <form
                                                method="post"
                                                action="{{ path('app_nanny_rate_delete', {'publicId': nanny.publicId, 'ratePublicId': rate.publicId}) }}"
                                                data-controller="confirm"
                                                data-action="submit->confirm#submit"
                                                data-confirm-title-value="Supprimer ce tarif ?"
                                                data-confirm-text-value="La suppression est bloquee si un mois paye est impacte."
                                                data-confirm-confirm-text-value="Supprimer"
                                            >
                                                <input type="hidden" name="_token" value="{{ csrf_token('delete_rate_' ~ rate.publicId) }}">
                                                <button class="font-medium text-red-700 hover:text-red-900">Supprimer</button>
                                            </form>
                                        </div>
                                    </div>
                                {% else %}
                                    <div class="rounded-md border border-amber-200 bg-amber-50 px-3 py-2 text-sm text-amber-800">
                                        Aucun tarif configure.
                                    </div>
                                {% endfor %}
                            </div>
                        </div>

                        <div class="mt-4 flex flex-wrap gap-2">
                            <a href="{{ path('app_nanny_rate_new', {'publicId': nanny.publicId}) }}" class="rounded-md border border-slate-300 px-3 py-2 text-sm font-medium hover:bg-slate-50">Ajouter tarif</a>
                            {% if nanny.createdBy and nanny.createdBy.publicId == app.user.publicId %}
                                <a href="{{ path('app_nanny_edit', {'publicId': nanny.publicId}) }}" class="rounded-md border border-slate-300 px-3 py-2 text-sm font-medium hover:bg-slate-50">Modifier</a>
                            {% endif %}
                            <form
                                method="post"
                                action="{{ path('app_nanny_detach', {'publicId': nanny.publicId}) }}"
                                data-controller="confirm"
                                data-action="submit->confirm#submit"
                                data-confirm-title-value="Détacher cette nounou ?"
                                data-confirm-text-value="Le détachement est refusé s'il reste des gardes futures ou impayées."
                                data-confirm-confirm-text-value="Détacher"
                            >
                                <input type="hidden" name="_token" value="{{ csrf_token('detach_nanny_' ~ nanny.publicId) }}">
                                <button class="rounded-md border border-red-200 px-3 py-2 text-sm font-medium text-red-700 hover:bg-red-50">Detacher</button>
                            </form>
                        </div>
                    </article>
                {% else %}
                    <div class="rounded-lg border border-dashed border-slate-300 p-8 text-center text-sm text-slate-500 md:col-span-2">
                        <i class="fa-regular fa-address-book mb-2 text-xl text-slate-300"></i>
                        <p>Aucune nounou rattachee.</p>
                    </div>
                {% endfor %}
            </div>
        </div>

        <aside class="space-y-4">
            <div class="rounded-lg border border-slate-200 bg-white p-5">
                <h2 class="text-base font-semibold">Rechercher</h2>
                <form method="get" class="mt-3 flex gap-2">
                    <label for="nanny-search" class="sr-only">Nom, ville ou code postal</label>
                    <input id="nanny-search" name="q" value="{{ query }}" class="min-w-0 flex-1 rounded-md border border-slate-300 px-3 py-2 text-sm" placeholder="Nom, ville, CP">
                    <button class="rounded-md bg-slate-900 px-3 py-2 text-sm font-semibold text-white">OK</button>
                </form>
                <div class="mt-4 space-y-2">
                    {% for result in search_results %}
                        <div class="flex items-center justify-between gap-3 rounded-md border border-slate-200 px-3 py-2">
                            <div class="min-w-0">
                                <p class="text-sm font-medium">{{ result.fullName }}</p>
                                <p class="text-xs text-slate-500">{{ [result.postalCode, result.city]|filter(v => v)|join(' ')|default('Adresse non renseignee') }}</p>
                            </div>
                            <form method="post" action="{{ path('app_nanny_attach', {'publicId': result.publicId}) }}">
                                <input type="hidden" name="_token" value="{{ csrf_token('attach_nanny_' ~ result.publicId) }}">
                                <button class="rounded-md bg-teal-600 px-3 py-1.5 text-xs font-semibold text-white">Rattacher</button>
                            </form>
                        </div>
                    {% else %}
                        <p class="rounded-md border border-dashed border-slate-200 px-3 py-3 text-sm text-slate-500">
                            {% if query|length < 2 %}
                                Saisissez au moins 2 caracteres.
                            {% else %}
                                Aucun resultat disponible.
                            {% endif %}
                        </p>
                    {% endfor %}
                </div>
            </div>

            <div class="rounded-lg border border-slate-200 bg-white p-5">
                <h2 class="text-base font-semibold">Code</h2>
                <form method="post" action="{{ path('app_nanny_attach_by_code') }}" class="mt-3 space-y-3">
                    <input type="hidden" name="_token" value="{{ csrf_token('attach_nanny_by_code') }}">
                    <label for="nanny-invite-code" class="sr-only">Code de rattachement</label>
                    <input id="nanny-invite-code" name="invite_code" class="w-full rounded-md border border-slate-300 px-3 py-2 text-sm" placeholder="Code de rattachement">
                    <button class="w-full rounded-md bg-teal-600 px-3 py-2 text-sm font-semibold text-white">Rattacher</button>
                </form>
            </div>
        </aside>
    </div>
</div>
{% endblock %}
