{% extends 'base.html.twig' %}

{% block title %}Connexion{% endblock %}

{% block body %}
<div class="mx-auto flex min-h-[calc(100vh-14rem)] max-w-md items-center px-4 py-10">
    <div class="w-full rounded-lg border border-slate-200 bg-white p-6 shadow-sm">
        <div>
            <h1 class="text-2xl font-semibold text-slate-950">Connexion</h1>
            <p class="mt-2 text-sm text-slate-500">Utilisez votre identifiant et votre mot de passe.</p>
        </div>

        <form method="post" class="mt-6 space-y-5">
            {% if error %}
                <div class="rounded-md border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700">
                    {{ error.messageKey|trans(error.messageData, 'security') }}
                </div>
            {% endif %}

            {% if app.user %}
                <div class="rounded-md border border-sky-200 bg-sky-50 px-4 py-3 text-sm text-sky-800">
                    Connecté en tant que {{ app.user.userIdentifier }}.
                    <a href="{{ path('app_logout') }}" class="font-medium underline">Déconnexion</a>
                </div>
            {% endif %}

            <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

            <div>
                <label for="username" class="text-sm font-medium text-slate-700">Identifiant</label>
                <input type="text" id="username" name="_username" value="{{ last_username }}" required autocomplete="username" autofocus class="mt-2 w-full rounded-md border border-slate-300 px-3 py-2 text-sm shadow-sm focus:border-sky-500 focus:outline-none focus:ring-2 focus:ring-sky-100">
            </div>

            <div>
                <label for="password" class="text-sm font-medium text-slate-700">Mot de passe</label>
                <input type="password" id="password" name="_password" required autocomplete="current-password" class="mt-2 w-full rounded-md border border-slate-300 px-3 py-2 text-sm shadow-sm focus:border-sky-500 focus:outline-none focus:ring-2 focus:ring-sky-100">
            </div>

            <label class="flex items-center gap-2 text-sm text-slate-700">
                <input type="checkbox" id="_remember_me" name="_remember_me" class="h-4 w-4 rounded border-slate-300 text-sky-600 focus:ring-sky-500">
                Se souvenir de moi
            </label>

            <button type="submit" class="inline-flex w-full items-center justify-center rounded-md bg-sky-600 px-4 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-sky-700 focus:outline-none focus:ring-2 focus:ring-sky-500 focus:ring-offset-2">
                Se connecter
            </button>
        </form>

        <p class="mt-5 text-center text-sm text-slate-500">
            Pas encore de compte ?
            <a href="{{ path('app_register') }}" class="font-medium text-sky-700 hover:text-sky-800">Créer un compte</a>
        </p>
    </div>
</div>
{% endblock %}
