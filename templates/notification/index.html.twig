{% extends 'base.html.twig' %}
{% block title %}Notifications{% endblock %}
{% block body %}<div class="space-y-5"><div class="flex items-center justify-between gap-3"><div><h1 class="text-2xl font-semibold">Notifications</h1><p class="text-sm text-slate-500">Alertes internes et historique de votre foyer.</p></div><form method="post" action="{{ path('app_notification_read_all') }}"><input type="hidden" name="_token" value="{{ csrf_token('notifications_read_all') }}"><button class="rounded-md border border-slate-300 px-3 py-2 text-sm font-medium">Tout marquer comme lu</button></form></div><section class="rounded-lg border border-slate-200 bg-white"><div class="divide-y divide-slate-100">{% for notification in notifications %}<article class="flex gap-4 px-5 py-4 {{ notification.read ? 'opacity-65' : '' }}"><span class="mt-1 h-2.5 w-2.5 shrink-0 rounded-full {{ notification.read ? 'bg-slate-300' : (notification.kind == 'warning' ? 'bg-rose-500' : 'bg-teal-500') }}"></span><div class="min-w-0 flex-1"><p class="font-semibold">{{ notification.title }}</p><p class="mt-1 text-sm text-slate-600">{{ notification.message }}</p><p class="mt-1 text-xs text-slate-400">{{ notification.createdAt|date('d/m/Y H:i') }}</p></div>{% if not notification.read %}<form method="post" action="{{ path('app_notification_read', {publicId:notification.publicId}) }}"><input type="hidden" name="_token" value="{{ csrf_token('notification_read_' ~ notification.publicId) }}"><button class="text-sm font-medium text-teal-700">Lire</button></form>{% elseif notification.link %}<a href="{{ notification.link }}" class="text-sm font-medium text-slate-600">Ouvrir</a>{% endif %}</article>{% else %}<p class="p-8 text-center text-sm text-slate-500">Aucune notification.</p>{% endfor %}</div></section></div>{% endblock %}
