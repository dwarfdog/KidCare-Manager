{% extends 'base.html.twig' %}
{% import 'components/_icon_action.html.twig' as icons %}
{% block title %}Notifications{% endblock %}
{% block body %}
{% set kind_icons = {calendar: 'calendar', document: 'file-lines', payment: 'money-check-dollar', warning: 'triangle-exclamation', information: 'circle-info'} %}
<div class="space-y-5"><div class="flex items-center justify-between gap-3"><div><h1 class="text-2xl font-semibold">Notifications</h1><p class="text-sm text-slate-500">Alertes internes et historique de votre foyer.</p></div><form method="post" action="{{ path('app_notification_read_all') }}"><input type="hidden" name="_token" value="{{ csrf_token('notifications_read_all') }}"><button class="rounded-md border border-slate-300 px-3 py-2 text-sm font-medium"><i class="fa-solid fa-check-double"></i> Tout marquer comme lu</button></form></div><section class="rounded-lg border border-slate-200 bg-white"><div class="divide-y divide-slate-100">{% for notification in notifications %}<article class="flex gap-4 px-5 py-4 {{ notification.read ? 'opacity-65' : '' }}"><span class="mt-0.5 flex h-6 w-6 shrink-0 items-center justify-center rounded-full text-[10px] text-white {{ notification.read ? 'bg-slate-300' : (notification.kind == 'warning' ? 'bg-rose-500' : 'bg-teal-500') }}" data-tippy-content="{{ notification.read ? 'Lue' : (notification.kind == 'warning' ? 'Importante' : 'Information') }}"><i class="fa-solid fa-{{ kind_icons[notification.kind]|default('bell') }}"></i></span><div class="min-w-0 flex-1"><p class="font-semibold">{{ notification.title }}</p><p class="mt-1 text-sm text-slate-600">{{ notification.message }}</p><p class="mt-1 text-xs text-slate-400">{{ notification.createdAt|date('d/m/Y H:i') }}</p></div>{% if not notification.read %}<form method="post" action="{{ path('app_notification_read', {publicId:notification.publicId}) }}">{{ icons.button('check', 'Marquer comme lue', 'primary', {type: 'submit'}) }}<input type="hidden" name="_token" value="{{ csrf_token('notification_read_' ~ notification.publicId) }}"></form>{% elseif notification.link %}{{ icons.link('arrow-up-right-from-square', 'Ouvrir', notification.link) }}{% endif %}</article>{% else %}<p class="p-8 text-center text-sm text-slate-500">Aucune notification.</p>{% endfor %}</div></section></div>{% endblock %}
