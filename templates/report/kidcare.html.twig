{% extends 'base.html.twig' %}{% block title %}Rapports KidCare{% endblock %}{% block body %}<div class="space-y-5"><div><h1 class="text-2xl font-semibold">Rapports KidCare</h1><p class="text-sm text-slate-500">Uniquement les gardes réalisées ou explicitement rémunérées.</p></div><form method="get" class="grid grid-cols-1 gap-3 rounded-lg border border-slate-200 bg-white p-4 sm:grid-cols-4"><label class="text-sm font-medium">Du<input type="date" name="from" value="{{ from|date('Y-m-d') }}" class="mt-1 w-full rounded-md border border-slate-300 px-3 py-2"></label><label class="text-sm font-medium">Au<input type="date" name="to" value="{{ to|date('Y-m-d') }}" class="mt-1 w-full rounded-md border border-slate-300 px-3 py-2"></label><label class="text-sm font-medium">Nounou<select name="nanny" class="mt-1 w-full rounded-md border border-slate-300 px-3 py-2"><option value="">Toutes</option>{% for nanny in nannies %}<option value="{{ nanny.publicId }}" {{ selected_nanny and selected_nanny.publicId==nanny.publicId?'selected':'' }}>{{ nanny.fullName }}</option>{% endfor %}</select></label><button class="self-end rounded-md bg-slate-900 px-4 py-2 text-sm font-semibold text-white">Afficher</button></form><div class="grid grid-cols-3 gap-3">{% for label,value in {'Heures':report.summary.hours,'Repas':report.summary.meals,'Montant':report.summary.amount} %}<div class="rounded-lg border border-slate-200 bg-white p-4"><p class="text-sm text-slate-500">{{ label }}</p><p class="mt-1 text-xl font-semibold">{{ value|number_format(label=='Repas'?0:2, ',', ' ') }}{{ label=='Montant'?' '~currency:(label=='Heures'?' h':'') }}</p></div>{% endfor %}</div><div class="flex flex-wrap gap-2">{% set format_icons = {csv: 'file-csv', xlsx: 'file-excel', pdf: 'file-pdf'} %}{% for format in ['csv','xlsx','pdf'] %}<a href="{{ path('app_kidcare_report_export',{format:format,from:from|date('Y-m-d'),to:to|date('Y-m-d'),nanny:selected_nanny?selected_nanny.publicId:''}) }}" class="rounded-md border border-slate-300 px-3 py-2 text-sm font-medium"><i class="fa-solid fa-{{ format_icons[format] }}"></i> Exporter {{ format|upper }}</a>{% endfor %}</div>{% if report.byMonth|length > 0 %}<div class="grid grid-cols-1 gap-3 lg:grid-cols-2"><div class="rounded-lg border border-slate-200 bg-white p-5"><h2 class="font-semibold">Montant par mois</h2><div class="mt-3 h-64" data-controller="bank-chart" data-bank-chart-type-value="line" data-bank-chart-labels-value="{{ report.byMonth|map(m => date(m.month~'-01')|format_date('none', 'MMM yyyy', locale='fr'))|json_encode|e('html_attr') }}" data-bank-chart-values-value="{{ report.byMonth|map(m => m.amount)|json_encode|e('html_attr') }}"><canvas data-bank-chart-target="canvas"></canvas></div></div><div class="rounded-lg border border-slate-200 bg-white p-5"><h2 class="font-semibold">Heures par mois</h2><div class="mt-3 h-64" data-controller="bank-chart" data-bank-chart-type-value="line" data-bank-chart-unit-value="hours" data-bank-chart-labels-value="{{ report.byMonth|map(m => date(m.month~'-01')|format_date('none', 'MMM yyyy', locale='fr'))|json_encode|e('html_attr') }}" data-bank-chart-values-value="{{ report.byMonth|map(m => m.hours)|json_encode|e('html_attr') }}"><canvas data-bank-chart-target="canvas"></canvas></div></div></div>{% endif %}<section class="overflow-hidden rounded-lg border border-slate-200 bg-white"><div class="overflow-x-auto"><table class="min-w-full text-sm"><thead class="bg-slate-50"><tr><th class="px-4 py-3 text-left">Date</th><th class="px-4 py-3 text-left">Nounou</th><th class="px-4 py-3 text-left">Horaire</th><th class="px-4 py-3 text-right">Heures</th><th class="px-4 py-3 text-left">État</th><th class="px-4 py-3 text-right">Montant</th></tr></thead><tbody class="divide-y divide-slate-100">{% for row in report.rows %}<tr><td class="px-4 py-3">{{ row.care.date|date('d/m/Y') }}</td><td class="px-4 py-3">{{ row.nanny }}</td><td class="px-4 py-3">{{ row.care.startTime|date('H:i') }}–{{ row.care.endTime|date('H:i') }}</td><td class="px-4 py-3 text-right">{{ row.care.hoursCount|number_format(2,',',' ') }}</td><td class="px-4 py-3">{{ row.status }}</td><td class="px-4 py-3 text-right">{{ row.amount|number_format(2,',',' ') }} {{ currency }}</td></tr>{% else %}<tr><td colspan="6" class="p-8 text-center text-slate-500">Aucune donnée exploitable.</td></tr>{% endfor %}</tbody></table></div></section></div>{% endblock %}
