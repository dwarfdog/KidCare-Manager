<!doctype html><html lang="fr"><head><meta charset="utf-8"><style>body{font-family:DejaVu Sans;font-size:10px}h1{font-size:18px}table{width:100%;border-collapse:collapse}th,td{border:1px solid #ddd;padding:5px;text-align:left}.right{text-align:right}</style></head><body><h1>Rapport KidCare{% if nanny %} — {{ nanny.fullName }}{% endif %}</h1><p>Du {{ from|date('d/m/Y') }} au {{ to|date('d/m/Y') }} · {{ report.summary.hours|number_format(2,',',' ') }} h · {{ report.summary.amount|number_format(2,',',' ') }} {{ currency }}</p><table><thead><tr><th>Date</th><th>Nounou</th><th>Horaire</th><th>État</th><th class="right">Montant</th></tr></thead><tbody>{% for row in report.rows %}<tr><td>{{ row.care.date|date('d/m/Y') }}</td><td>{{ row.nanny }}</td><td>{{ row.care.startTime|date('H:i') }}–{{ row.care.endTime|date('H:i') }}</td><td>{{ row.status }}</td><td class="right">{{ row.amount|number_format(2,',',' ') }} {{ currency }}</td></tr>{% endfor %}</tbody></table></body></html>
